<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="TrackZPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{StaticResource TrackZPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource TrackZPrimaryContrast}" />
    </Style>
    <Style x:Key="TrackZCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{StaticResource TrackZSurface}" />
        <Setter Property="Stroke" Value="{StaticResource TrackZHairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
    </Style>
    <Style x:Key="TrackZListRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{StaticResource TrackZSurface}" />
        <Setter Property="Stroke" Value="{StaticResource TrackZHairline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>
    <Style x:Key="TrackZStatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BackgroundColor" Value="{StaticResource TrackZSurfaceRaised}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
    </Style>
</ResourceDictionary>
