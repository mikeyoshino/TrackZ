<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="TrackZPageTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="TrackZCoachPageTitleStyle" TargetType="Label" BasedOn="{StaticResource TrackZPageTitleStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="TrackZHistoryTitleStyle" TargetType="Label" BasedOn="{StaticResource TrackZPageTitleStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiLight" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="TrackZHistoryMonthStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{DynamicResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZProfileTitleStyle" TargetType="Label" BasedOn="{StaticResource TrackZHistoryTitleStyle}" />
    <Style x:Key="TrackZHistoryDateStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZBrandGlyphStyle" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TrackZPrimaryContrast}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="TrackZBrandNameStyle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZAuthBrandNameStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansThaiSemiBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="CharacterSpacing" Value="0.4" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZAuthHeadlineStyle" TargetType="Label" BasedOn="{StaticResource TrackZPageTitleStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiLight" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.32" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="TrackZAuthPromptStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZAuthCompactBrandNameStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansThaiSemiBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="CharacterSpacing" Value="0.4" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZFieldLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZAuthFieldLabelStyle" TargetType="Label" BasedOn="{StaticResource TrackZFieldLabelStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiMedium" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="TrackZNavigationTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZSectionTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZBodyStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZSecondaryStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextSecondary}" />
    </Style>
    <Style x:Key="TrackZHomeContextStyle" TargetType="Label" BasedOn="{StaticResource TrackZSecondaryStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="TrackZHomeHeadlineStyle" TargetType="Label" BasedOn="{StaticResource TrackZPageTitleStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiLight" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>
    <Style x:Key="TrackZHomeHeroEyebrowStyle" TargetType="Label" BasedOn="{StaticResource TrackZSecondaryStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="TrackZHomeHeroTitleStyle" TargetType="Label" BasedOn="{StaticResource TrackZSectionTitleStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiSemiBold" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="21" />
    </Style>
    <Style x:Key="TrackZHomeBodyStyle" TargetType="Label" BasedOn="{StaticResource TrackZBodyStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <Style x:Key="TrackZHomeSectionTitleStyle" TargetType="Label" BasedOn="{StaticResource TrackZSectionTitleStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiMedium" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="19" />
    </Style>
    <Style x:Key="TrackZHomeMetricLabelStyle" TargetType="Label" BasedOn="{StaticResource TrackZSecondaryStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="TrackZHomeMetricNumberStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansThaiSemiBold" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="TextColor" Value="{StaticResource TrackZPrimary}" />
        <Setter Property="VerticalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="TrackZHomeMetricDividerStyle" TargetType="Label" BasedOn="{StaticResource TrackZHomeMetricNumberStyle}">
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZHomeMetricGoalStyle" TargetType="Label" BasedOn="{StaticResource TrackZHomeMetricNumberStyle}">
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
    </Style>
    <Style x:Key="TrackZHomeMetricUnitStyle" TargetType="Label" BasedOn="{StaticResource TrackZSecondaryStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="VerticalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="TrackZHomeEmptyTitleStyle" TargetType="Label" BasedOn="{StaticResource TrackZSectionTitleStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiMedium" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="TrackZHomeEmptySupportingStyle" TargetType="Label" BasedOn="{StaticResource TrackZSecondaryStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>
    <Style x:Key="TrackZFieldErrorStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource TrackZDanger}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="TrackZPerformanceNumberStyle" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TrackZPrimary}" />
    </Style>
    <Style x:Key="TrackZPerformanceMetadataStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextSecondary}" />
    </Style>
    <Style x:Key="TrackZAuthRequirementStyle" TargetType="Label" BasedOn="{StaticResource TrackZSecondaryStyle}">
        <Setter Property="FontFamily" Value="NotoSansThaiRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{StaticResource TrackZTextPrimary}" />
        <Setter Property="Opacity" Value="0.78" />
    </Style>
</ResourceDictionary>
