<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TrackZ.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource TrackZBackground}"
    Shell.BackgroundColor="{DynamicResource TrackZBackground}"
    Shell.ForegroundColor="{DynamicResource TrackZTextPrimary}"
    Shell.TabBarBackgroundColor="{DynamicResource TrackZSurface}"
    Shell.TabBarDisabledColor="{DynamicResource TrackZTextSecondary}"
    Shell.TabBarForegroundColor="{DynamicResource TrackZPrimary}"
    Shell.TabBarTitleColor="{DynamicResource TrackZPrimary}"
    Shell.TabBarUnselectedColor="{DynamicResource TrackZTextSecondary}"
    FlyoutBehavior="Disabled">

</Shell>
