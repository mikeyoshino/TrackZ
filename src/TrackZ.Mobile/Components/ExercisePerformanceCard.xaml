<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.ExercisePerformanceCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TrackZ.Mobile.Features.Exercises.Models;assembly=TrackZ.Mobile.Core">
    <Border
        x:Name="CardBody"
        x:DataType="models:ExercisePickerItem"
        MinimumHeightRequest="{DynamicResource TrackZExerciseCardHeight}"
        Style="{DynamicResource TrackZListRowStyle}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer x:Name="SelectionTap" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="88,*,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}" RowDefinitions="Auto,Auto,Auto">
            <Grid Grid.RowSpan="3" HeightRequest="{DynamicResource TrackZExerciseArtworkSize}" WidthRequest="{DynamicResource TrackZExerciseArtworkSize}">
                <Image
                    x:Name="ArtworkImage"
                    Aspect="AspectFit"
                    IsVisible="{Binding HasArtwork}"
                    SemanticProperties.Description="{Binding ArtworkAccessibilityText}"
                    Source="{Binding ThumbnailUri}" />
                <Border
                    BackgroundColor="{DynamicResource TrackZSurfaceRaised}"
                    IsVisible="{Binding ShowsArtworkPlaceholder}"
                    SemanticProperties.Description="{Binding ArtworkPlaceholderText}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">
                    <Grid>
                        <Image Aspect="AspectFit" HeightRequest="58" Source="exercise_placeholder.png" WidthRequest="58" />
                        <ActivityIndicator IsRunning="{Binding IsArtworkLoading}" IsVisible="{Binding IsArtworkLoading}" />
                    </Grid>
                </Border>
            </Grid>

            <VerticalStackLayout Grid.Column="1" Spacing="{DynamicResource TrackZSpace4}">
                <Label x:Name="ExerciseNameLabel" LineBreakMode="TailTruncation" Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding Name}" />
                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding TrackingModeText}" />
            </VerticalStackLayout>
            <Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding LastText}" />
            <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="{DynamicResource TrackZSpace8}">
                <Label Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding PersonalRecordText}" />
                <Button
                    Command="{Binding RetryArtworkCommand}"
                    IsVisible="{Binding HasFailedArtwork}"
                    Style="{DynamicResource TrackZQuietButtonStyle}"
                    Text="{Binding RetryArtworkText}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.RowSpan="3" Grid.Column="2" Spacing="{DynamicResource TrackZSpace4}" VerticalOptions="Center">
                <CheckBox
                    InputTransparent="True"
                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                    SemanticProperties.Description="{Binding SelectionAccessibilityText}" />
                <Button
                    x:Name="EditAction"
                    CommandParameter="{Binding Exercise}"
                    IsVisible="{Binding IsCustom}"
                    Style="{DynamicResource TrackZQuietButtonStyle}"
                    Text="{Binding EditLabel}" />
                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SyncLabel}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
