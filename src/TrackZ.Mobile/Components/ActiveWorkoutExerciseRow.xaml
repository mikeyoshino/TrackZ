<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.ActiveWorkoutExerciseRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:workout="clr-namespace:TrackZ.Mobile.Features.Workout;assembly=TrackZ.Mobile.Core"
    x:DataType="workout:WorkoutExerciseDraftItem">
    <SwipeView>
        <SwipeView.LeftItems>
            <SwipeItems Mode="Reveal">
                <SwipeItem
                    BackgroundColor="{DynamicResource TrackZSurfaceRaised}"
                    Command="{Binding MoveUpCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding Exercise, Source={x:Reference Root}}"
                    Text="{Binding MoveUpText, Source={x:Reference Root}}" />
                <SwipeItem
                    BackgroundColor="{DynamicResource TrackZSurfaceRaised}"
                    Command="{Binding MoveDownCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding Exercise, Source={x:Reference Root}}"
                    Text="{Binding MoveDownText, Source={x:Reference Root}}" />
            </SwipeItems>
        </SwipeView.LeftItems>
        <SwipeView.RightItems>
            <SwipeItems Mode="Execute">
                <SwipeItem
                    BackgroundColor="{DynamicResource TrackZDanger}"
                    Command="{Binding RemoveCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding Exercise, Source={x:Reference Root}}"
                    IsDestructive="True"
                    Text="{Binding RemoveText, Source={x:Reference Root}}" />
            </SwipeItems>
        </SwipeView.RightItems>

        <Border
            AutomationProperties.IsInAccessibleTree="True"
            MinimumHeightRequest="{DynamicResource TrackZExerciseCardHeight}"
            Padding="12"
            SemanticProperties.Description="{Binding Exercise.AccessibilitySummary, Source={x:Reference Root}}"
            Style="{DynamicResource TrackZListRowStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCommand, Source={x:Reference Root}}" CommandParameter="{Binding Exercise, Source={x:Reference Root}}" />
            </Border.GestureRecognizers>
            <Grid AutomationProperties.ExcludedWithChildren="True"
                  ColumnDefinitions="72,*,Auto,Auto"
                  ColumnSpacing="{DynamicResource TrackZSpace12}">
                <Grid x:Name="ActiveWorkoutArtwork"
                      HeightRequest="{DynamicResource TrackZCompactExerciseArtworkSize}"
                      WidthRequest="{DynamicResource TrackZCompactExerciseArtworkSize}">
                    <Image Aspect="AspectFit"
                           IsVisible="{Binding Exercise.HasArtwork, Source={x:Reference Root}}"
                           Source="{Binding Exercise.ThumbnailUri, Source={x:Reference Root}}" />
                    <Border BackgroundColor="{DynamicResource TrackZSurfaceRaised}"
                            IsVisible="{Binding Exercise.ShowsArtworkPlaceholder, Source={x:Reference Root}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">
                        <Image Aspect="AspectFit" HeightRequest="42" Source="exercise_placeholder.png" WidthRequest="42" />
                    </Border>
                </Grid>
                <Label Grid.Column="1"
                       LineBreakMode="WordWrap"
                       MaxLines="2"
                       Style="{DynamicResource TrackZNavigationTitleStyle}"
                       Text="{Binding Exercise.Name, Source={x:Reference Root}}"
                       VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                    <Border Padding="12,4"
                            Stroke="{DynamicResource TrackZPrimary}"
                            StrokeShape="RoundRectangle 999"
                            StrokeThickness="1">
                        <Label x:Name="WorkoutExerciseSetCounter"
                               AutomationProperties.IsInAccessibleTree="False"
                               HorizontalTextAlignment="Center"
                               Style="{DynamicResource TrackZBodyStyle}"
                               Text="{Binding Exercise.LoggedSetText, Source={x:Reference Root}}"
                               />
                    </Border>
                    <Label x:Name="WorkoutExerciseSetStatus"
                           AutomationProperties.IsInAccessibleTree="False"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           Text="{Binding Exercise.SetStatusText, Source={x:Reference Root}}"
                           TextColor="{DynamicResource TrackZTextSecondary}" />
                </VerticalStackLayout>
                <Label x:Name="WorkoutExerciseChevron"
                       Grid.Column="3"
                       AutomationProperties.IsInAccessibleTree="False"
                       FontSize="24"
                       Text="›"
                       TextColor="{DynamicResource TrackZTextSecondary}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
    </SwipeView>
</ContentView>
