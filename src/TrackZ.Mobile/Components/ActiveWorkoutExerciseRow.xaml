<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.ActiveWorkoutExerciseRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:workout="clr-namespace:TrackZ.Mobile.Features.Workout;assembly=TrackZ.Mobile.Core"
    x:DataType="workout:WorkoutExerciseDraftItem">
    <SwipeView>
        <SwipeView.LeftItems>
            <SwipeItems Mode="Reveal">
                <SwipeItem
                    BackgroundColor="{DynamicResource TrackZSurfaceRaised}"
                    Command="{Binding MoveUpCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding Exercise, Source={x:Reference Root}}"
                    Text="{Binding MoveUpText, Source={x:Reference Root}}" />
                <SwipeItem
                    BackgroundColor="{DynamicResource TrackZSurfaceRaised}"
                    Command="{Binding MoveDownCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding Exercise, Source={x:Reference Root}}"
                    Text="{Binding MoveDownText, Source={x:Reference Root}}" />
            </SwipeItems>
        </SwipeView.LeftItems>
        <SwipeView.RightItems>
            <SwipeItems Mode="Execute">
                <SwipeItem
                    BackgroundColor="{DynamicResource TrackZDanger}"
                    Command="{Binding RemoveCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding Exercise, Source={x:Reference Root}}"
                    IsDestructive="True"
                    Text="{Binding RemoveText, Source={x:Reference Root}}" />
            </SwipeItems>
        </SwipeView.RightItems>

        <Border
            MinimumHeightRequest="{DynamicResource TrackZExerciseCardHeight}"
            SemanticProperties.Description="{Binding Exercise.AccessibilitySummary, Source={x:Reference Root}}"
            Style="{DynamicResource TrackZListRowStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCommand, Source={x:Reference Root}}" CommandParameter="{Binding Exercise, Source={x:Reference Root}}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}">
                <Grid HeightRequest="{DynamicResource TrackZActiveArtworkSize}" WidthRequest="{DynamicResource TrackZActiveArtworkSize}">
                    <Image Aspect="AspectFit" IsVisible="{Binding Exercise.HasArtwork, Source={x:Reference Root}}" Source="{Binding Exercise.ThumbnailUri, Source={x:Reference Root}}" />
                    <Border BackgroundColor="{DynamicResource TrackZSurfaceRaised}" IsVisible="{Binding Exercise.ShowsArtworkPlaceholder, Source={x:Reference Root}}" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Image Aspect="AspectFit" HeightRequest="52" Source="exercise_placeholder.svg" WidthRequest="52" />
                    </Border>
                </Grid>
                <VerticalStackLayout Grid.Column="1" Spacing="{DynamicResource TrackZSpace4}" VerticalOptions="Center">
                    <Label LineBreakMode="TailTruncation" Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding Exercise.Name, Source={x:Reference Root}}" />
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Exercise.TrackingModeText, Source={x:Reference Root}}" />
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Exercise.LastText, Source={x:Reference Root}}" />
                    <Label Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding Exercise.LoggedSetText, Source={x:Reference Root}}" />
                </VerticalStackLayout>
                <Label Grid.Column="2" FontSize="24" Text="›" TextColor="{DynamicResource TrackZTextSecondary}" VerticalOptions="Center" />
            </Grid>
        </Border>
    </SwipeView>
</ContentView>
