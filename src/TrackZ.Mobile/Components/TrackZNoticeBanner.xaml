<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.TrackZNoticeBanner"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    IsVisible="False">
    <Border
        x:Name="NoticeSurface"
        AutomationProperties.IsInAccessibleTree="True"
        BackgroundColor="{DynamicResource TrackZSurfaceRaised}"
        Padding="12"
        SemanticProperties.Description="{Binding Text, Source={x:Reference Root}}"
        Stroke="{DynamicResource TrackZInformation}"
        StrokeShape="RoundRectangle 12"
        StrokeThickness="1">
        <Grid ColumnDefinitions="28,*,44" ColumnSpacing="12">
            <Label
                x:Name="NoticeIcon"
                AutomationProperties.IsInAccessibleTree="False"
                FontAttributes="Bold"
                FontSize="17"
                HorizontalTextAlignment="Center"
                Text="i"
                TextColor="{DynamicResource TrackZInformation}"
                VerticalTextAlignment="Center" />
            <Label
                x:Name="NoticeMessage"
                Grid.Column="1"
                Style="{DynamicResource TrackZBodyStyle}"
                Text="{Binding Text, Source={x:Reference Root}}"
                VerticalTextAlignment="Center" />
            <Button
                x:Name="DismissNoticeButton"
                Grid.Column="2"
                AutomationProperties.IsInAccessibleTree="True"
                BackgroundColor="Transparent"
                Command="{Binding DismissCommand, Source={x:Reference Root}}"
                FontSize="20"
                IsVisible="False"
                MinimumHeightRequest="44"
                MinimumWidthRequest="44"
                Padding="0"
                SemanticProperties.Description="{Binding DismissText, Source={x:Reference Root}}"
                Text="×"
                TextColor="{DynamicResource TrackZTextSecondary}" />
        </Grid>
    </Border>
</ContentView>
