<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.WeightStepper"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="7">
        <Label
            FontAttributes="Bold"
            FontSize="12"
            Text="{Binding Caption, Source={x:Reference Root}}"
            TextColor="#8E959F" />
        <Grid ColumnDefinitions="52,*,52" ColumnSpacing="8">
            <Button
                Command="{Binding DecrementCommand, Source={x:Reference Root}}"
                CornerRadius="14"
                FontSize="24"
                HeightRequest="52"
                MinimumHeightRequest="44"
                MinimumWidthRequest="44"
                SemanticProperties.Description="{Binding DecrementLabel, Source={x:Reference Root}}"
                Text="−" />
            <Border Grid.Column="1" Padding="10,0" BackgroundColor="#1B1F25" Stroke="#303640" StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalTextAlignment="Center"
                        Keyboard="Numeric"
                        MinimumHeightRequest="44"
                        ReturnType="Done"
                        SemanticProperties.Description="{Binding Caption, Source={x:Reference Root}}"
                        Text="{Binding Value, Source={x:Reference Root}, Mode=TwoWay}" />
                    <Label
                        Grid.Column="1"
                        Margin="4,0"
                        Text="{Binding UnitLabel, Source={x:Reference Root}}"
                        TextColor="#8E959F"
                        VerticalTextAlignment="Center" />
                </Grid>
            </Border>
            <Button
                Grid.Column="2"
                Command="{Binding IncrementCommand, Source={x:Reference Root}}"
                CornerRadius="14"
                FontSize="24"
                HeightRequest="52"
                MinimumHeightRequest="44"
                MinimumWidthRequest="44"
                SemanticProperties.Description="{Binding IncrementLabel, Source={x:Reference Root}}"
                Text="+" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
