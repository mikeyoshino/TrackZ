<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.BadgeTile"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gamification="clr-namespace:TrackZ.Contracts.Gamification;assembly=TrackZ.Contracts"
    x:DataType="gamification:EarnedBadgeDto">
    <Border Padding="12" BackgroundColor="#15181D" Stroke="#343B45" StrokeShape="RoundRectangle 18">
        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
            <Border HeightRequest="44" WidthRequest="44" BackgroundColor="#26310D" Stroke="#C8FF3D" StrokeShape="RoundRectangle 22">
                <Label HorizontalTextAlignment="Center" Text="★" TextColor="#C8FF3D" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label FontAttributes="Bold" Text="{Binding NameResourceKey}" TextColor="#F4F7FA" />
                <Label FontSize="11" Text="{Binding EarnedAt, StringFormat='Earned {0:d}'}" TextColor="#8E959F" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
