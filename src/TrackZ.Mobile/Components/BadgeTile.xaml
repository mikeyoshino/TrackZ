<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.BadgeTile"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gamification="clr-namespace:TrackZ.Contracts.Gamification;assembly=TrackZ.Contracts"
    x:DataType="gamification:EarnedBadgeDto">
    <Border Padding="12" BackgroundColor="{DynamicResource TrackZSurface}" Stroke="{DynamicResource TrackZHairline}" StrokeShape="RoundRectangle 18">
        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
            <Border HeightRequest="44" WidthRequest="44" BackgroundColor="{DynamicResource TrackZSurfaceRaised}" Stroke="{DynamicResource TrackZPrimary}" StrokeShape="RoundRectangle 22">
                <Label HorizontalTextAlignment="Center" Text="★" TextColor="{DynamicResource TrackZPrimary}" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label FontAttributes="Bold" Text="{Binding NameResourceKey}" TextColor="{DynamicResource TrackZTextPrimary}" />
                <Label FontSize="11" Text="{Binding EarnedAt, StringFormat='Earned {0:d}'}" TextColor="{DynamicResource TrackZTextSecondary}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
