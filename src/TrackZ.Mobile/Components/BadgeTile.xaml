<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.BadgeTile"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gamification="clr-namespace:TrackZ.Contracts.Gamification;assembly=TrackZ.Contracts"
    x:DataType="gamification:EarnedBadgeDto">
    <Border Style="{DynamicResource TrackZCardStyle}">
        <Grid ColumnDefinitions="44,*" ColumnSpacing="{DynamicResource TrackZSpace12}">
            <Border HeightRequest="44" WidthRequest="44" BackgroundColor="{DynamicResource TrackZSurfaceRaised}" Stroke="{DynamicResource TrackZPrimary}" StrokeShape="RoundRectangle 22">
                <Label HorizontalTextAlignment="Center" Style="{DynamicResource TrackZNavigationTitleStyle}" Text="★" TextColor="{DynamicResource TrackZPrimary}" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="{DynamicResource TrackZSpace4}" VerticalOptions="Center">
                <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding NameResourceKey}" />
                <Label Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding EarnedAt, StringFormat='Earned {0:d}'}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
