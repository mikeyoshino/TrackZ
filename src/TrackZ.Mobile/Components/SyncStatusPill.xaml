<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.SyncStatusPill"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border x:Name="Pill" Style="{DynamicResource TrackZStatusPillStyle}">
        <Label
            SemanticProperties.Description="{Binding Text, Source={x:Reference Root}}"
            Style="{DynamicResource TrackZSecondaryStyle}"
            Text="{Binding Text, Source={x:Reference Root}}" />
    </Border>
</ContentView>
