<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.LastSetTable"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:workout="clr-namespace:TrackZ.Mobile.Features.Workout;assembly=TrackZ.Mobile.Core">
    <VerticalStackLayout Spacing="8">
        <Label
            FontAttributes="Bold"
            FontSize="12"
            CharacterSpacing="1.6"
            Text="{Binding Header, Source={x:Reference Root}}"
            TextColor="{DynamicResource TrackZPrimary}" />
        <CollectionView
            ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="workout:SetDisplayRow">
                    <Grid Padding="0,7" ColumnDefinitions="40,*">
                        <Label
                            FontAttributes="Bold"
                            SemanticProperties.Description="{Binding SetNumber}"
                            Text="{Binding SetNumber}"
                            TextColor="{DynamicResource TrackZTextSecondary}" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalTextAlignment="End"
                            SemanticProperties.Description="{Binding MeasurementText}"
                            Text="{Binding MeasurementText}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
