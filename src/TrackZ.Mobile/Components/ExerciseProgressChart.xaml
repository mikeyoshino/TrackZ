<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="TrackZ.Mobile.Components.ExerciseProgressChart" x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="{DynamicResource TrackZSpace8}">
        <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding ExerciseName, Source={x:Reference Root}}" />
        <Label Grid.Column="1" Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding PersonalRecordText, Source={x:Reference Root}}" />
        <Grid Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="20">
            <BoxView HeightRequest="2" Color="{DynamicResource TrackZBorder}" VerticalOptions="Center" />
            <Ellipse Fill="{DynamicResource TrackZPrimary}" HeightRequest="10" HorizontalOptions="End" WidthRequest="10" />
        </Grid>
    </Grid>
</ContentView>
