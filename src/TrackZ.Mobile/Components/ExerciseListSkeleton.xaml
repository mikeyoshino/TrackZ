<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.ExerciseListSkeleton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="10">
        <Border HeightRequest="104" Style="{DynamicResource TrackZCardStyle}">
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="14" />
                <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="6" HeightRequest="16" WidthRequest="160" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="5" HeightRequest="12" WidthRequest="110" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="5" HeightRequest="12" WidthRequest="190" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <Border HeightRequest="104" Style="{DynamicResource TrackZCardStyle}">
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="14" />
                <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="6" HeightRequest="16" WidthRequest="140" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="5" HeightRequest="12" WidthRequest="100" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="5" HeightRequest="12" WidthRequest="175" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <Border HeightRequest="104" Style="{DynamicResource TrackZCardStyle}">
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="14" />
                <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="6" HeightRequest="16" WidthRequest="180" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="5" HeightRequest="12" WidthRequest="120" HorizontalOptions="Start" />
                    <BoxView BackgroundColor="{DynamicResource TrackZSurfaceRaised}" CornerRadius="5" HeightRequest="12" WidthRequest="155" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
