<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.TrackZStateView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout
        HorizontalOptions="Center"
        MaximumWidthRequest="360"
        Padding="24"
        Spacing="12"
        VerticalOptions="Center">
        <Label
            HorizontalTextAlignment="Center"
            Style="{DynamicResource TrackZSectionTitleStyle}"
            Text="{Binding Title, Source={x:Reference Root}}" />
        <Label
            HorizontalTextAlignment="Center"
            Style="{DynamicResource TrackZSecondaryStyle}"
            Text="{Binding Message, Source={x:Reference Root}}" />
        <Button
            x:Name="ActionButton"
            IsVisible="False"
            MinimumHeightRequest="48"
            Style="{DynamicResource TrackZPrimaryButtonStyle}" />
    </VerticalStackLayout>
</ContentView>
