<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="TrackZ.Mobile.Components.WeeklyStreakView" x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{DynamicResource TrackZCardStyle}" SemanticProperties.Description="{Binding AccessibilityText, Source={x:Reference Root}}">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto"><Label FontAttributes="Bold" FontSize="17" Text="{Binding Title, Source={x:Reference Root}}" /><Label Grid.Column="1" FontAttributes="Bold" Text="{Binding CurrentWeeks, Source={x:Reference Root}}" TextColor="{DynamicResource TrackZPrimary}" /></Grid>
            <ProgressBar Progress="{Binding Progress, Source={x:Reference Root}}" ProgressColor="{DynamicResource TrackZPrimary}" />
            <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding CompletedText, Source={x:Reference Root}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
