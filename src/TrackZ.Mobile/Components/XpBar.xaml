<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.XpBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace8}">
        <Grid ColumnDefinitions="*,Auto">
            <Label Style="{DynamicResource TrackZPerformanceNumberStyle}" Text="{Binding Level, Source={x:Reference Root}, StringFormat='LEVEL {0}'}" />
            <Label Grid.Column="1" Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding TotalXp, Source={x:Reference Root}, StringFormat='{0:N0} XP'}" />
        </Grid>
        <ProgressBar Progress="{Binding Progress, Source={x:Reference Root}}" ProgressColor="{DynamicResource TrackZPrimary}" />
    </VerticalStackLayout>
</ContentView>
