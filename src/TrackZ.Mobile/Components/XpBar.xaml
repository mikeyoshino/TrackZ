<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.XpBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace8}">
        <Grid ColumnDefinitions="*,Auto">
            <Label Style="{DynamicResource TrackZPerformanceNumberStyle}">
                <Label.Text>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <Binding Path="LevelLabel" Source="{x:Reference Root}" />
                        <Binding Path="Level" Source="{x:Reference Root}" />
                    </MultiBinding>
                </Label.Text>
            </Label>
            <Label Grid.Column="1" Style="{DynamicResource TrackZPerformanceMetadataStyle}">
                <Label.Text>
                    <MultiBinding StringFormat="{}{0:N0} {1}">
                        <Binding Path="TotalXp" Source="{x:Reference Root}" />
                        <Binding Path="XpLabel" Source="{x:Reference Root}" />
                    </MultiBinding>
                </Label.Text>
            </Label>
        </Grid>
        <ProgressBar Progress="{Binding Progress, Source={x:Reference Root}}" ProgressColor="{DynamicResource TrackZPrimary}" />
    </VerticalStackLayout>
</ContentView>
