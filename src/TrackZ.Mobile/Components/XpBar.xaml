<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TrackZ.Mobile.Components.XpBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
            <Label FontAttributes="Bold" FontSize="18" Text="{Binding Level, Source={x:Reference Root}, StringFormat='LEVEL {0}'}" TextColor="#C8FF3D" />
            <Label Grid.Column="1" Text="{Binding TotalXp, Source={x:Reference Root}, StringFormat='{0:N0} XP'}" TextColor="#F4F7FA" />
        </Grid>
        <ProgressBar Progress="{Binding Progress, Source={x:Reference Root}}" ProgressColor="#C8FF3D" />
    </VerticalStackLayout>
</ContentView>
