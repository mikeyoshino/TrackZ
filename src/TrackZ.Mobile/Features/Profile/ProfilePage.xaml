<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Profile.ProfilePage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gamification="clr-namespace:TrackZ.Mobile.Features.Gamification;assembly=TrackZ.Mobile.Core"
    xmlns:localization="clr-namespace:TrackZ.Mobile.Features.Localization;assembly=TrackZ.Mobile.Core"
    x:DataType="gamification:ProfileViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False"
    Title="{Binding Text.ProfileTitle}">
    <Grid Padding="0,16,0,0" RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="{DynamicResource TrackZPageBottomContentPadding}" Spacing="{DynamicResource TrackZSpace16}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{DynamicResource TrackZProfileTitleStyle}" Text="{Binding Text.ProfileTitle}" />
                        <Label x:Name="ProfileSubtitle" Style="{DynamicResource TrackZSecondaryStyle}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="trackz_auth_logo.png" WidthRequest="32" HeightRequest="32" AutomationProperties.ExcludedWithChildren="True" />
                </Grid>
                <ContentView x:Name="ScheduleHost" />
                <Border x:Name="LanguageSettingsCard" Style="{DynamicResource TrackZCardStyle}">
                    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace12}">
                        <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding MobileText.Language}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource TrackZSpace8}">
                            <Button
                                x:Name="ThaiLanguageButton"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="{x:Static localization:AppLanguage.Thai}"
                                SemanticProperties.Description="{Binding Languages[0].AccessibilityLabel}"
                                Style="{DynamicResource TrackZSecondaryButtonStyle}"
                                Text="{Binding Languages[0].Label}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Languages[0].IsSelected}" Value="True">
                                        <Setter Property="BorderColor" Value="{DynamicResource TrackZPrimary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource TrackZPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button
                                x:Name="EnglishLanguageButton"
                                Grid.Column="1"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="{x:Static localization:AppLanguage.English}"
                                SemanticProperties.Description="{Binding Languages[1].AccessibilityLabel}"
                                Style="{DynamicResource TrackZSecondaryButtonStyle}"
                                Text="{Binding Languages[1].Label}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Languages[1].IsSelected}" Value="True">
                                        <Setter Property="BorderColor" Value="{DynamicResource TrackZPrimary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource TrackZPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                        <Label Style="{DynamicResource TrackZInlineErrorStyle}" Text="{Binding LanguageError}" />
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="WeightUnitSettingsCard" Style="{DynamicResource TrackZCardStyle}">
                    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace12}">
                        <Label x:Name="WeightUnitTitle" Style="{DynamicResource TrackZHistoryDateStyle}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource TrackZSpace8}">
                            <Button x:Name="KilogramsButton" Clicked="OnKilogramsClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Source={x:Reference Page}, Path=WorkoutText.Kilograms}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference Page}, Path=IsKilogramsSelected}" Value="True">
                                        <Setter Property="BorderColor" Value="{DynamicResource TrackZPrimary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource TrackZPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button x:Name="PoundsButton" Grid.Column="1" Clicked="OnPoundsClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Source={x:Reference Page}, Path=WorkoutText.Pounds}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference Page}, Path=IsPoundsSelected}" Value="True">
                                        <Setter Property="BorderColor" Value="{DynamicResource TrackZPrimary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource TrackZPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{DynamicResource TrackZListRowStyle}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="HapticsTitle" Style="{DynamicResource TrackZHistoryDateStyle}" />
                        <Switch x:Name="HapticsSwitch" Grid.Column="1" Style="{DynamicResource TrackZSwitchStyle}" Toggled="OnHapticsToggled" />
                    </Grid>
                </Border>
                <Border Style="{DynamicResource TrackZListRowStyle}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{DynamicResource TrackZHistoryDateStyle}" Text="{Binding Text.ReduceMotion}" />
                        <Switch x:Name="ReduceMotionSwitch" Grid.Column="1" Style="{DynamicResource TrackZSwitchStyle}" Toggled="OnReduceMotionToggled" />
                    </Grid>
                </Border>
                <Label Style="{DynamicResource TrackZInlineErrorStyle}" Text="{Binding ErrorMessage}" />
                <Label Style="{DynamicResource TrackZInlineErrorStyle}" Text="{Binding Source={x:Reference Page}, Path=SignOut.ErrorMessage}" />
                <Button
                    Command="{Binding Source={x:Reference Page}, Path=SignOut.SignOutCommand}"
                    Style="{DynamicResource TrackZDestructiveButtonStyle}"
                    Text="{Binding Text.SignOut}" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Margin="0,0,0,12" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Button x:Name="SavePlanButton" Clicked="OnSavePlanClicked" Style="{DynamicResource TrackZPrimaryButtonStyle}" />
        </Border>
    </Grid>
</ContentPage>
