<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Summary.WorkoutSummaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:gamification="clr-namespace:TrackZ.Mobile.Features.Gamification;assembly=TrackZ.Mobile.Core"
    x:DataType="gamification:WorkoutSummaryViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    Title="{Binding Text.SummaryTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="18">
            <Label Style="{DynamicResource TrackZPageTitleStyle}" Text="{Binding Text.SummaryTitle}" />
            <Border x:Name="SummaryReveal" Style="{DynamicResource TrackZCardStyle}">
                <VerticalStackLayout Spacing="6"><Label FontAttributes="Bold" FontSize="22" Text="{Binding ProgressRevealStatus}" TextColor="{DynamicResource TrackZPrimary}" /><Label FontAttributes="Bold" Text="{Binding XpEarnedText}" /><Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding LevelAdvancedText}" /></VerticalStackLayout>
            </Border>
            <Border Style="{DynamicResource TrackZCardStyle}">
                <components:XpBar Level="{Binding Level}" TotalXp="{Binding TotalXp}" Progress="0" />
            </Border>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Style="{DynamicResource TrackZCardStyle}"><VerticalStackLayout><Label FontSize="24" FontAttributes="Bold" Text="{Binding TotalVolumeKg, StringFormat='{0:0.###} kg'}" /><Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.TotalVolume}" /></VerticalStackLayout></Border>
                <Border Grid.Column="1" Style="{DynamicResource TrackZCardStyle}"><VerticalStackLayout><Label FontSize="24" FontAttributes="Bold" Text="{Binding CompletedSets}" /><Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.Sets}" /></VerticalStackLayout></Border>
                <Border Grid.Column="2" Style="{DynamicResource TrackZCardStyle}"><VerticalStackLayout><Label FontSize="24" FontAttributes="Bold" Text="{Binding TotalReps}" /><Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.Reps}" /></VerticalStackLayout></Border>
            </Grid>
            <Label SemanticProperties.Description="{Binding SyncAccessibilityText}" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SyncAccessibilityText}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource TrackZDanger}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
