<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Summary.WorkoutSummaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:gamification="clr-namespace:TrackZ.Mobile.Features.Gamification;assembly=TrackZ.Mobile.Core"
    x:DataType="gamification:WorkoutSummaryViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Title="{Binding Text.SummaryTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="{DynamicResource TrackZPageContentPadding}" Spacing="{DynamicResource TrackZSpace16}">
            <Border x:Name="SummaryReveal" IsVisible="{Binding HasProgressReveal}" Style="{DynamicResource TrackZCardStyle}">
                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace8}">
                    <Label x:Name="ConfirmedRevealStatus" IsVisible="{Binding IsProgressRevealConfirmed}" Style="{DynamicResource TrackZPerformanceNumberStyle}" Text="{Binding ProgressRevealStatus}" />
                    <Label x:Name="PendingRevealStatus" IsVisible="{Binding IsProgressRevealPending}" Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding ProgressRevealStatus}" />
                    <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding XpEarnedText}" />
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding LevelAdvancedText}" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="SummaryXpCard" IsVisible="{Binding HasAuthoritativeProgressData}" Style="{DynamicResource TrackZCardStyle}">
                <components:XpBar Level="{Binding Level}" LevelLabel="{Binding Text.Level}" TotalXp="{Binding TotalXp}" XpLabel="{Binding Text.Xp}" Progress="{Binding LevelProgress}" />
            </Border>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource TrackZSpace8}">
                <Border Style="{DynamicResource TrackZCardStyle}">
                    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                        <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding TotalVolumeText}" />
                        <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.TotalVolume}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{DynamicResource TrackZCardStyle}">
                    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                        <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding CompletedSets}" />
                        <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.Sets}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource TrackZCardStyle}">
                    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                        <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding TotalReps}" />
                        <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.Reps}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Label x:Name="SummarySyncStatus" IsVisible="{Binding HasAuthoritativeProgressData}" SemanticProperties.Description="{Binding SyncAccessibilityText}" Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding SyncAccessibilityText}" />
            <Label Style="{DynamicResource TrackZInlineErrorStyle}" Text="{Binding ErrorMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
