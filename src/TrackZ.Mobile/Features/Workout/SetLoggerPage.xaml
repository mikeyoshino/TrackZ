<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Workout.SetLoggerPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:workout="clr-namespace:TrackZ.Mobile.Features.Workout;assembly=TrackZ.Mobile.Core"
    x:DataType="workout:SetLoggerViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    Title="{Binding Text.SetLoggerTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="18,18,18,30" Spacing="18">
            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                <Grid HeightRequest="64" WidthRequest="64">
                    <Image Aspect="AspectFit" IsVisible="{Binding HasArtwork}" Source="{Binding ThumbnailUri}" />
                    <Border BackgroundColor="{DynamicResource TrackZSurfaceRaised}" IsVisible="{Binding ShowsArtworkPlaceholder}" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Image Aspect="AspectFit" HeightRequest="46" Source="exercise_placeholder.svg" WidthRequest="46" />
                    </Border>
                </Grid>
                <VerticalStackLayout Grid.Column="1">
                    <Label FontAttributes="Bold" FontSize="28" Text="{Binding ExerciseName}" />
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding ExerciseMetadataText}" />
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding PreviousBestText}" />
                    <Label FontAttributes="Bold" FontSize="13" Text="{Binding AllTimePrText}" TextColor="{DynamicResource TrackZPrimary}" />
                </VerticalStackLayout>
                <components:SyncStatusPill Grid.Column="2" State="{Binding SyncState}" Text="{Binding SyncStatusText}" VerticalOptions="Start" />
            </Grid>

            <Border Style="{DynamicResource TrackZCardStyle}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                    <components:LastSetTable Header="{Binding Text.Last}" ItemsSource="{Binding LastSets}" />
                    <components:LastSetTable Grid.Column="1" Header="{Binding Text.Today}" ItemsSource="{Binding TodaySets}" />
                </Grid>
            </Border>

            <Border Padding="14" BackgroundColor="{DynamicResource TrackZSurfaceRaised}" IsVisible="{Binding HasConflict}" Stroke="{DynamicResource TrackZWarning}" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" Text="{Binding Text.Conflicted}" TextColor="{DynamicResource TrackZWarning}" />
                    <Label Text="{Binding ConflictLocalSummary}" />
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding ConflictServerSummary}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Command="{Binding KeepServerCommand}" Text="{Binding Text.KeepServer}" />
                        <Button Grid.Column="1" Command="{Binding ApplyLocalCommand}" Text="{Binding Text.ApplyLocal}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="SavedPulse" Padding="14" BackgroundColor="{DynamicResource TrackZSurfaceRaised}" Opacity="0" Stroke="{DynamicResource TrackZPrimary}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="SavedPrimary" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{DynamicResource TrackZPrimary}" />
                    <Label x:Name="SavedSecondary" HorizontalTextAlignment="Center" Style="{DynamicResource TrackZSecondaryStyle}" />
                </VerticalStackLayout>
            </Border>
            <Label HorizontalTextAlignment="Center" Text="{Binding ErrorMessage}" TextColor="{DynamicResource TrackZDanger}" />
            <Button
                Clicked="OnLogNextSetClicked"
                MinimumHeightRequest="54"
                SemanticProperties.Description="{Binding Text.LogNextSet}"
                Style="{DynamicResource TrackZPrimaryButtonStyle}"
                Text="{Binding Text.LogNextSet}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
