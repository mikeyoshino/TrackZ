<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Workout.WorkoutPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:workout="clr-namespace:TrackZ.Mobile.Features.Workout;assembly=TrackZ.Mobile.Core"
    x:DataType="workout:WorkoutViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarHasShadow="False"
    Shell.NavBarIsVisible="True"
    Title="{Binding Text.WorkoutTitle}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⋯" Clicked="OnWorkoutMenuClicked" />
    </ContentPage.ToolbarItems>
    <Grid Padding="0,16,0,0" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{DynamicResource TrackZSpace12}">
        <Grid Padding="{DynamicResource TrackZPageHorizontalPadding}" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="WorkoutContext" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding WorkoutContextText}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasExercises}">
                    <ProgressBar x:Name="WorkoutProgress"
                                 Progress="{Binding WorkoutProgress}"
                                 ProgressColor="{DynamicResource TrackZPrimary}"
                                 VerticalOptions="Center" />
                    <Label x:Name="WorkoutProgressText"
                           Grid.Column="1"
                           Style="{DynamicResource TrackZPerformanceMetadataStyle}"
                           Text="{Binding WorkoutProgressText}"
                           TextColor="{DynamicResource TrackZTextSecondary}" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Padding="{DynamicResource TrackZPageHorizontalPadding}">
          <CollectionView ItemsSource="{Binding Exercises}" SelectionMode="None" IsVisible="{Binding HasExercises}">
            <CollectionView.EmptyView>
                <Label HorizontalTextAlignment="Center" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Source={x:Reference Page}, Path=BindingContext.Text.NoExercises}" VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="workout:WorkoutExerciseDraftItem">
                    <components:ActiveWorkoutExerciseRow
                        Margin="0,0,0,4"
                        Exercise="{Binding .}"
                        MoveDownCommand="{Binding Source={x:Reference Page}, Path=BindingContext.MoveDownCommand}"
                        MoveDownText="{Binding Source={x:Reference Page}, Path=BindingContext.Text.MoveDown}"
                        MoveUpCommand="{Binding Source={x:Reference Page}, Path=BindingContext.MoveUpCommand}"
                        MoveUpText="{Binding Source={x:Reference Page}, Path=BindingContext.Text.MoveUp}"
                        OpenCommand="{Binding Source={x:Reference Page}, Path=OpenLoggerCommand}"
                        RemoveCommand="{Binding Source={x:Reference Page}, Path=BindingContext.RemoveExerciseCommand}"
                        RemoveText="{Binding Source={x:Reference Page}, Path=BindingContext.Text.Remove}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
          <VerticalStackLayout x:Name="EmptyWorkoutState" IsVisible="{Binding IsEmpty}"
                               VerticalOptions="Center" HorizontalOptions="Fill" Spacing="16" Margin="0,0,0,48">
              <Image Source="workout_empty.png" WidthRequest="56" HeightRequest="56" HorizontalOptions="Center"
                     AutomationProperties.ExcludedWithChildren="True" />
              <Label Text="{Binding Text.EmptyWorkoutTitle}" Style="{DynamicResource TrackZHomeEmptyTitleStyle}"
                     HorizontalTextAlignment="Center" />
              <Label Text="{Binding Text.EmptyWorkoutHelper}" Style="{DynamicResource TrackZSecondaryStyle}"
                     HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </Grid>

        <components:TrackZNoticeBanner
            x:Name="WorkoutNotice"
            Grid.Row="2"
            DismissCommand="{Binding DismissNoticeCommand}"
            DismissText="{Binding Text.DismissNotice}"
            Margin="18,0"
            Severity="{Binding NoticeSeverity}"
            Text="{Binding NoticeMessage}" />

        <Border x:Name="WorkoutActions" Grid.Row="3" Margin="0,0,0,12" Padding="18,8" StrokeThickness="0" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Grid ColumnDefinitions="0.38*,0.62*" ColumnSpacing="12">
                <Button x:Name="AddExerciseButton" Clicked="OnAddExerciseClicked"
                        Style="{DynamicResource TrackZSecondaryButtonStyle}"
                        BackgroundColor="Transparent" BorderWidth="1"
                        BorderColor="{DynamicResource TrackZTextSecondary}"
                        Text="{Binding Text.AddExercise}" />
                <Button x:Name="StartFirstExerciseButton" Grid.Column="1"
                        Command="{Binding StartWorkoutCommand}"
                        IsVisible="{Binding IsDraft}"
                        Style="{DynamicResource TrackZPrimaryButtonStyle}"
                        Text="{Binding Text.StartFirstExercise}" />
                <Button x:Name="LogNextSetButton" Grid.Column="1"
                        Command="{Binding LogNextSetCommand}"
                        IsVisible="{Binding HasStarted}"
                        Style="{DynamicResource TrackZPrimaryButtonStyle}"
                        Text="{Binding Text.LogNextWorkoutSet}" />
            </Grid>
        </Border>
        <components:BusyOverlay Grid.RowSpan="4" IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
