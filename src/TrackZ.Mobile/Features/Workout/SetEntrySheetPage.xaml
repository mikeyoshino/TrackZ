<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Workout.SetEntrySheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:workout="clr-namespace:TrackZ.Mobile.Features.Workout;assembly=TrackZ.Mobile.Core"
    x:DataType="workout:SetLoggerViewModel"
    BackgroundColor="{DynamicResource TrackZSurface}"
    Shell.NavBarIsVisible="False">
    <Grid Padding="20,18,20,24" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="3">
                <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding NextSetText}" />
                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding ExerciseName}" />
            </VerticalStackLayout>
            <Button
                Grid.Column="1"
                BackgroundColor="Transparent"
                Clicked="OnCancelClicked"
                MinimumHeightRequest="44"
                Text="{Binding Text.Cancel}"
                TextColor="{DynamicResource TrackZTextSecondary}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <Button
                    Command="{Binding MatchLastCommand}"
                    MinimumHeightRequest="48"
                    SemanticProperties.Description="{Binding Text.MatchLast}"
                    Text="{Binding Text.MatchLast}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding UsesWeight}">
                    <Button Command="{Binding UseKilogramsCommand}" IsEnabled="{Binding IsPounds}" MinimumHeightRequest="44" Text="{Binding Text.Kilograms}" />
                    <Button Grid.Column="1" Command="{Binding UsePoundsCommand}" IsEnabled="{Binding IsKilograms}" MinimumHeightRequest="44" Text="{Binding Text.Pounds}" />
                </Grid>

                <components:WeightStepper
                    Caption="{Binding WeightCaption}"
                    DecrementCommand="{Binding DecrementWeightCommand}"
                    DecrementLabel="{Binding DecrementWeightDescription}"
                    IncrementCommand="{Binding IncrementWeightCommand}"
                    IncrementLabel="{Binding IncrementWeightDescription}"
                    IsVisible="{Binding UsesWeight}"
                    UnitLabel="{Binding WeightUnitLabel}"
                    Value="{Binding DisplayWeight, Mode=TwoWay}" />

                <Label
                    IsVisible="{Binding IsAssisted}"
                    Style="{DynamicResource TrackZSecondaryStyle}"
                    Text="{Binding Text.LowerAssistanceProgress}" />

                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding IsBodyweight}"
                    Text="{Binding Text.Bodyweight}"
                    TextColor="{DynamicResource TrackZPrimary}" />

                <components:RepsStepper
                    Caption="{Binding Text.Reps}"
                    DecrementCommand="{Binding DecrementRepsCommand}"
                    DecrementLabel="{Binding DecrementRepsDescription}"
                    IncrementCommand="{Binding IncrementRepsCommand}"
                    IncrementLabel="{Binding IncrementRepsDescription}"
                    Value="{Binding Reps, Mode=TwoWay}" />
                <Label HorizontalTextAlignment="Center" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding ValidationMessage}" TextColor="{DynamicResource TrackZDanger}" />
            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="2"
            Clicked="OnSaveClicked"
            IsEnabled="{Binding CanCompleteSet}"
            MinimumHeightRequest="54"
            SemanticProperties.Description="{Binding Text.SaveSet}"
            Style="{DynamicResource TrackZPrimaryButtonStyle}"
            Text="{Binding Text.SaveSet}" />

        <Border
            x:Name="RewardOverlay"
            Grid.RowSpan="3"
            Margin="18"
            Opacity="0"
            Padding="24"
            BackgroundColor="{DynamicResource TrackZSurfaceRaised}"
            HorizontalOptions="Center"
            Stroke="{DynamicResource TrackZPrimary}"
            StrokeShape="RoundRectangle 24"
            VerticalOptions="Center">
            <VerticalStackLayout Spacing="6">
                <Label x:Name="RewardPrimary" FontAttributes="Bold" FontSize="22" HorizontalTextAlignment="Center" TextColor="{DynamicResource TrackZPrimary}" />
                <Label x:Name="RewardSecondary" HorizontalTextAlignment="Center" Style="{DynamicResource TrackZSecondaryStyle}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
