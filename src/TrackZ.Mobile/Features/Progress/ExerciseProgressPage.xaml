<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="TrackZ.Mobile.Features.Progress.ExerciseProgressPage" x:Name="Page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:TrackZ.Mobile.Components" xmlns:gamification="clr-namespace:TrackZ.Mobile.Features.Gamification;assembly=TrackZ.Mobile.Core" x:DataType="gamification:ProgressDashboardViewModel" BackgroundColor="{DynamicResource TrackZBackground}" Shell.NavBarIsVisible="False" Title="{Binding Text.ProgressTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="18,10,18,28" Spacing="16">
            <Label Style="{DynamicResource TrackZPageTitleStyle}" Text="{Binding Text.ProgressTitle}" />
            <Border Style="{DynamicResource TrackZCardStyle}"><components:XpBar Level="{Binding Level}" TotalXp="{Binding TotalXp}" Progress="{Binding LevelProgress}" /></Border>
            <components:WeeklyStreakView AccessibilityText="{Binding Text.StreakAccessibilityText}" CompletedText="{Binding WeeklyProgressText}" CurrentWeeks="{Binding CurrentStreakWeeks}" Progress="{Binding WeeklyProgress}" Title="{Binding Text.WeeklyGoal}" />
            <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="PR" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="12">
                <BindableLayout.ItemTemplate><DataTemplate x:DataType="gamification:ExerciseProgressItem"><Border Style="{DynamicResource TrackZCardStyle}"><components:ExerciseProgressChart ExerciseName="{Binding ExerciseName}" PersonalRecordText="{Binding PersonalRecordText}" /></Border></DataTemplate></BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.Badges}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Badges}" Spacing="10"><BindableLayout.ItemTemplate><DataTemplate><components:BadgeTile /></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
            <Label SemanticProperties.Description="{Binding SyncAccessibilityText}" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SyncAccessibilityText}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource TrackZDanger}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
