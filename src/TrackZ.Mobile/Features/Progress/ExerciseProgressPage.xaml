<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Progress.ExerciseProgressPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gamification="clr-namespace:TrackZ.Mobile.Features.Gamification;assembly=TrackZ.Mobile.Core"
    x:DataType="gamification:ExerciseProgressViewModel"
    BackgroundColor="#0D0F12"
    Title="{Binding Text.ProgressTitle}">
    <Grid Padding="18,20" RowDefinitions="Auto,*" RowSpacing="16">
        <VerticalStackLayout>
            <Label FontAttributes="Bold" FontSize="30" Text="{Binding Text.ProgressTitle}" />
            <Label Text="{Binding SyncAccessibilityText}" TextColor="#F2B84B" />
            <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Exercises}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="gamification:ExerciseProgressItem">
                    <Border Margin="0,0,0,12" Padding="14" BackgroundColor="#15181D" Stroke="#343B45" StrokeShape="RoundRectangle 18">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding ExerciseName}" />
                            <Label Grid.Column="1" Text="PR" TextColor="#C8FF3D" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="20" Text="{Binding PersonalRecordText}" TextColor="#C8FF3D" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
