<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Progress.ExerciseProgressPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:gamification="clr-namespace:TrackZ.Mobile.Features.Gamification;assembly=TrackZ.Mobile.Core"
    x:DataType="gamification:ProgressDashboardViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False"
    Title="{Binding Text.ProgressTitle}">
    <ScrollView x:Name="ExerciseProgressScroll">
        <VerticalStackLayout Padding="{DynamicResource TrackZPageContentPadding}" Spacing="{DynamicResource TrackZSpace16}">
            <Label SemanticProperties.HeadingLevel="Level1" Style="{DynamicResource TrackZCoachPageTitleStyle}" Text="{Binding Text.ProgressTitle}" />
            <VerticalStackLayout x:Name="CoachReportHost" Spacing="16" />
            <VerticalStackLayout x:Name="ProgressSnapshotContent" IsVisible="{Binding HasAuthoritativeProgressData}" Spacing="{DynamicResource TrackZSpace16}">
                <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.PersonalRecords}" />
                <VerticalStackLayout
                    x:Name="ExerciseProgressRows"
                    BindableLayout.ItemsSource="{Binding Exercises}"
                    Spacing="{DynamicResource TrackZSpace12}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="gamification:ExerciseProgressItem">
                            <Border Style="{DynamicResource TrackZCardStyle}">
                                <components:ExerciseProgressChart ExerciseName="{Binding ExerciseName}" PersonalRecordText="{Binding PersonalRecordText}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.Badges}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Badges}" Spacing="{DynamicResource TrackZSpace12}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <components:BadgeTile />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Label Style="{DynamicResource TrackZInlineErrorStyle}" Text="{Binding ErrorMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
