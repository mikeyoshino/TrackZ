<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="TrackZ.Mobile.Features.Progress.ExerciseProgressPage"
 BackgroundColor="{DynamicResource TrackZBackground}" SafeAreaEdges="All" Shell.NavBarIsVisible="False">
 <ScrollView x:Name="ExerciseProgressScroll">
  <VerticalStackLayout Padding="{DynamicResource TrackZPageContentPadding}" Spacing="3">
   <Label x:Name="OverviewTitle" IsVisible="False" Style="{DynamicResource TrackZProgressPageTitleStyle}"
    SemanticProperties.HeadingLevel="Level1" />
   <VerticalStackLayout x:Name="ProgressContent" Spacing="14" />
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
