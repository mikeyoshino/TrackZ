<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.History.HistorySetEditorSheetPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:history="clr-namespace:TrackZ.Mobile.Features.History;assembly=TrackZ.Mobile.Core"
    x:DataType="history:HistorySetItem"
    BackgroundColor="{DynamicResource TrackZSurface}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">
    <Grid Padding="0,16,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource TrackZSpace16}">
        <Grid Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding Source={x:Reference Page}, Path=Text.Edit}" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Padding="{DynamicResource TrackZPageHorizontalPadding}" Spacing="{DynamicResource TrackZSpace12}">
            <Entry IsVisible="{Binding UsesExactWeight}" Keyboard="Numeric" Style="{DynamicResource TrackZFieldStyle}" Text="{Binding DisplayWeight, Mode=TwoWay}" />
            <Label IsVisible="{Binding UsesExactWeight}" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding WeightUnitLabel}" />
            <Entry IsVisible="{Binding UsesPlateCount}" Keyboard="Numeric" MaxLength="3" Placeholder="{Binding Source={x:Reference Page}, Path=Text.PlateCount}" Style="{DynamicResource TrackZFieldStyle}" Text="{Binding PlateCount, Mode=TwoWay}" />
            <Entry Keyboard="Numeric" MaxLength="3" Style="{DynamicResource TrackZFieldStyle}" Text="{Binding Reps, Mode=TwoWay}" />
        </VerticalStackLayout>
        <Border Grid.Row="2" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource TrackZSpace8}">
                <Button Clicked="OnCancelClicked" Style="{DynamicResource TrackZQuietButtonStyle}" Text="{Binding Source={x:Reference Page}, Path=Text.Cancel}" />
                <Button Grid.Column="1" Clicked="OnDeleteClicked" Style="{DynamicResource TrackZDestructiveButtonStyle}" Text="{Binding Source={x:Reference Page}, Path=Text.Delete}" />
                <Button Grid.Column="2" Clicked="OnSaveClicked" Style="{DynamicResource TrackZPrimaryButtonStyle}" Text="{Binding Source={x:Reference Page}, Path=Text.Confirm}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
