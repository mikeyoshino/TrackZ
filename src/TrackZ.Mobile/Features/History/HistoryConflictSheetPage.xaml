<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.History.HistoryConflictSheetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:history="clr-namespace:TrackZ.Mobile.Features.History;assembly=TrackZ.Mobile.Core"
    x:DataType="history:WorkoutHistoryDetailViewModel"
    BackgroundColor="{DynamicResource TrackZSurface}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">
    <Grid Padding="0,16,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource TrackZSpace16}">
        <VerticalStackLayout Padding="{DynamicResource TrackZPageHorizontalPadding}" Spacing="{DynamicResource TrackZSpace4}">
            <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding Text.Conflicted}" />
            <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Workout.SyncStatusText}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Padding="{DynamicResource TrackZPageHorizontalPadding}" Spacing="{DynamicResource TrackZSpace12}">
            <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Workout.ConflictOperationText}" />
            <Label Style="{DynamicResource TrackZBodyStyle}" Text="{Binding Workout.ConflictLocalSummary}" />
            <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Workout.ConflictServerSummary}" />
            <Label Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding Workout.ExerciseCountText}" />
            <Label Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding Workout.SetCountText}" />
        </VerticalStackLayout>
        <Border Grid.Row="2" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource TrackZSpace12}">
                <Button Clicked="OnKeepServerClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.KeepServer}" />
                <Button Grid.Column="1" Clicked="OnApplyLocalClicked" Style="{DynamicResource TrackZPrimaryButtonStyle}" Text="{Binding Text.ApplyLocal}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
