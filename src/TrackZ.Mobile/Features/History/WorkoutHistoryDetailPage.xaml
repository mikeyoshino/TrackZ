<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.History.WorkoutHistoryDetailPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:history="clr-namespace:TrackZ.Mobile.Features.History;assembly=TrackZ.Mobile.Core"
    x:DataType="history:WorkoutHistoryDetailViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Title="{Binding Text.HistoryTitle}">
    <Grid Padding="0,16,0,0" RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="{DynamicResource TrackZPageBottomContentPadding}" Spacing="{DynamicResource TrackZSpace16}">
                <Grid>
                    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                        <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding Workout.CompletedAt, StringFormat='{0:ddd, d MMM}'}" />
                        <Label Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding Workout.CompletedAt, StringFormat='{0:HH:mm}'}" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Workout.Exercises}" Spacing="{DynamicResource TrackZSpace12}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="history:HistoryExerciseItem">
                            <Border Style="{DynamicResource TrackZCardStyle}">
                                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace12}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding Name}" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteExerciseCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{DynamicResource TrackZDestructiveButtonStyle}"
                                            Text="{Binding Source={x:Reference Page}, Path=BindingContext.Text.Delete}" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="{DynamicResource TrackZSpace8}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="history:HistorySetItem">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}">
                                                    <Label Style="{DynamicResource TrackZPerformanceMetadataStyle}" Text="{Binding SetNumber, StringFormat='#{0}'}" VerticalTextAlignment="Center" />
                                                    <Label Grid.Column="1" Style="{DynamicResource TrackZBodyStyle}" Text="{Binding MeasurementText}" VerticalTextAlignment="Center" />
                                                    <Button Grid.Column="2" Clicked="OnEditSetClicked" CommandParameter="{Binding .}" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Source={x:Reference Page}, Path=BindingContext.Text.Edit}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Clicked="OnConflictClicked" IsVisible="{Binding Workout.HasConflict}" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.Conflicted}" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Margin="0,0,0,12" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource TrackZSpace12}">
                <Button Command="{Binding UndoCommand}" CommandParameter="{Binding Workout}" Style="{DynamicResource TrackZQuietButtonStyle}" Text="{Binding Text.Undo}" />
                <Button Grid.Column="1" Command="{Binding DeleteWorkoutCommand}" CommandParameter="{Binding Workout}" Style="{DynamicResource TrackZDestructiveButtonStyle}" Text="{Binding Text.Delete}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
