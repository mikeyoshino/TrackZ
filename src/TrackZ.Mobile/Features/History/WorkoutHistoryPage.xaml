<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.History.WorkoutHistoryPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:history="clr-namespace:TrackZ.Mobile.Features.History;assembly=TrackZ.Mobile.Core"
    x:DataType="history:WorkoutHistoryViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    Title="{Binding Text.HistoryTitle}">
    <Grid Padding="18,10,18,16" RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="3">
                <Label Style="{DynamicResource TrackZPageTitleStyle}" Text="{Binding Text.HistoryTitle}" />
                <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource TrackZDanger}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </Grid>
        <CollectionView Grid.Row="1" IsGrouped="True" ItemsSource="{Binding WorkoutGroups}" SelectionChanged="OnWorkoutSelected" SelectionMode="Single">
            <CollectionView.EmptyView>
                <Label HorizontalTextAlignment="Center" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Source={x:Reference Page}, Path=BindingContext.Text.NoHistory}" VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="history:HistoryMonthGroup">
                    <Label Margin="2,14,2,8" Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Month}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="history:HistoryWorkoutItem">
                    <Border Margin="0,0,0,10" Style="{DynamicResource TrackZListRowStyle}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding CompletedAt, StringFormat='{0:ddd, d MMM · HH:mm}'}" />
                            <components:SyncStatusPill Grid.Column="1" State="{Binding SyncState}" Text="{Binding SyncStatusText}" />
                            <HorizontalStackLayout Grid.Row="1" Spacing="14">
                                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding ExerciseCountText}" />
                                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SetCountText}" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Grid.Column="1" FontSize="22" Text="›" TextColor="{DynamicResource TrackZTextSecondary}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
