<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.History.WorkoutHistoryPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:history="clr-namespace:TrackZ.Mobile.Features.History;assembly=TrackZ.Mobile.Core"
    x:DataType="history:WorkoutHistoryViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False"
    Title="{Binding Text.HistoryTitle}">
    <Grid Padding="{DynamicResource TrackZPageContentPadding}" RowDefinitions="Auto,*" RowSpacing="{DynamicResource TrackZSpace16}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                <Label Style="{DynamicResource TrackZHistoryTitleStyle}" Text="{Binding Text.HistoryTitle}" />
                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SupportingText}" />
                <Label Style="{DynamicResource TrackZInlineErrorStyle}" Text="{Binding ErrorMessage}" />
            </VerticalStackLayout>
            <Button x:Name="FilterButton" Grid.Column="1" Style="{DynamicResource TrackZQuietButtonStyle}"
                    ImageSource="filter.png" Clicked="OnFilterClicked" VerticalOptions="Start" />
        </Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Calendar.SelectedWorkouts}" SelectionChanged="OnWorkoutSelected" SelectionMode="Single">
            <CollectionView.Header>
                <ContentView x:Name="CalendarHost" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="history:HistoryWorkoutItem">
                    <Border Margin="0,0,0,12" Style="{DynamicResource TrackZListRowStyle}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}" RowSpacing="{DynamicResource TrackZSpace4}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding LocalTimeText}" />
                                <Label Grid.Column="1" Style="{DynamicResource TrackZHistoryDateStyle}" Text="{Binding BodyPartTitle}" />
                            </Grid>
                            <components:WorkoutSyncIcon
                                Grid.Row="3"
                                Margin="0,4,0,0"
                                AccessibilityText="{Binding SyncStatusText}"
                                State="{Binding SyncState}"
                                VerticalOptions="Center" />
                            <Label Grid.Row="1" Margin="0,4,0,8" Style="{DynamicResource TrackZSecondaryStyle}"
                                   Text="{Binding ExercisePreview}" MaxLines="2" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Grid.Row="2" Spacing="{DynamicResource TrackZSpace16}">
                                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding ExerciseCountText}" />
                                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SetCountText}" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Grid.RowSpan="4" Style="{DynamicResource TrackZSecondaryStyle}" Text="›" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
