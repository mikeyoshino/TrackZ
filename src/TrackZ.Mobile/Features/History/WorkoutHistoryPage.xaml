<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.History.WorkoutHistoryPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:history="clr-namespace:TrackZ.Mobile.Features.History;assembly=TrackZ.Mobile.Core"
    x:DataType="history:WorkoutHistoryViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False"
    Title="{Binding Text.HistoryTitle}">
    <Grid Padding="{DynamicResource TrackZPageContentPadding}" RowDefinitions="Auto,*" RowSpacing="{DynamicResource TrackZSpace16}">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                <Label Style="{DynamicResource TrackZPageTitleStyle}" Text="{Binding Text.HistoryTitle}" />
                <Label Style="{DynamicResource TrackZInlineErrorStyle}" Text="{Binding ErrorMessage}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </Grid>
        <CollectionView Grid.Row="1" IsGrouped="True" ItemsSource="{Binding WorkoutGroups}" SelectionChanged="OnWorkoutSelected" SelectionMode="Single">
            <CollectionView.EmptyView>
                <Label HorizontalTextAlignment="Center" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Source={x:Reference Page}, Path=BindingContext.Text.NoHistory}" VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="history:HistoryMonthGroup">
                    <Label Margin="0,16,0,8" Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Month}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="history:HistoryWorkoutItem">
                    <Border Margin="0,0,0,12" Style="{DynamicResource TrackZListRowStyle}">
                        <Grid ColumnDefinitions="*,24,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}" RowSpacing="{DynamicResource TrackZSpace4}">
                            <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="{Binding CompletedAt, StringFormat='{0:ddd, d MMM · HH:mm}'}" />
                            <components:WorkoutSyncIcon
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                AccessibilityText="{Binding SyncStatusText}"
                                State="{Binding SyncState}"
                                VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Row="1" Spacing="{DynamicResource TrackZSpace16}">
                                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding ExerciseCountText}" />
                                <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SetCountText}" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="2" Grid.RowSpan="2" Style="{DynamicResource TrackZSecondaryStyle}" Text="›" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
