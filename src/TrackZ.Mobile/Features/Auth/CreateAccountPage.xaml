<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackZ.Mobile.Features.Auth.CreateAccountPage"
             SafeAreaEdges="All"
             BackgroundColor="{DynamicResource TrackZBackground}">
    <Grid Padding="0,24,0,0" RowDefinitions="Auto,*,Auto" BackgroundColor="{DynamicResource TrackZBackground}">
        <VerticalStackLayout Padding="{DynamicResource TrackZPageHorizontalPadding}" Spacing="{DynamicResource TrackZSpace12}">
            <Label Style="{DynamicResource TrackZPageTitleStyle}" Text="{Binding Text.CreateAccountTitle}" />
            <Label x:Name="WelcomeBodyLabel" Style="{DynamicResource TrackZBodyStyle}" Text="{Binding Text.CreateAccountWelcomeBody}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Padding="{DynamicResource TrackZPageHorizontalPadding}" Spacing="{DynamicResource TrackZSpace12}" VerticalOptions="Center">
            <Border x:Name="EmailFieldContainer" Style="{DynamicResource TrackZFieldContainerStyle}">
                <Entry x:Name="EmailInput" Style="{DynamicResource TrackZFieldStyle}" Text="{Binding Email}" Keyboard="Email" ReturnType="Next" SemanticProperties.Description="{Binding Text.EmailAccessibilityLabel}" />
            </Border>
            <Label Style="{DynamicResource TrackZFieldErrorStyle}" Text="{Binding EmailError}" />
            <Border x:Name="PasswordFieldContainer" Style="{DynamicResource TrackZFieldContainerStyle}">
                <Entry x:Name="PasswordInput" Style="{DynamicResource TrackZFieldStyle}" Text="{Binding Password}" IsPassword="True" ReturnType="Go" SemanticProperties.Description="{Binding Text.PasswordAccessibilityLabel}" />
            </Border>
            <Label Style="{DynamicResource TrackZFieldErrorStyle}" Text="{Binding PasswordError}" />
            <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.CreateAccountRequirements}" />
            <Label Style="{DynamicResource TrackZFieldErrorStyle}" Text="{Binding FormError}" />
        </VerticalStackLayout>
        <Border Grid.Row="2" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <VerticalStackLayout Spacing="{DynamicResource TrackZSpace8}">
                <Button x:Name="SubmitAction" Style="{DynamicResource TrackZPrimaryButtonStyle}" Text="{Binding Text.CreateAccountAction}" Command="{Binding SubmitCommand}" Clicked="OnSubmitClicked" SemanticProperties.Description="{Binding Text.CreateAccountAction}" />
                <Button x:Name="SwitchModeAction" Style="{DynamicResource TrackZQuietButtonStyle}" Text="{Binding Text.SignInLink}" Clicked="OnSwitchModeClicked" SemanticProperties.Description="{Binding Text.SignInLink}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
