<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackZ.Mobile.Features.Auth.AuthGatePage"
             SafeAreaEdges="All"
             BackgroundColor="{DynamicResource TrackZBackground}">
    <Grid Padding="{DynamicResource TrackZAuthGatePadding}">
        <ActivityIndicator x:Name="StatusIndicatorView"
                           IsRunning="True"
                           Color="{DynamicResource TrackZPrimary}"
                           SemanticProperties.Description="{Binding CheckingSessionAccessibilityLabel}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
