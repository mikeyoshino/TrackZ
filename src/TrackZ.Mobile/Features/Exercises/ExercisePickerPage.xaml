<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Exercises.ExercisePickerPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:models="clr-namespace:TrackZ.Mobile.Features.Exercises.Models;assembly=TrackZ.Mobile.Core"
    xmlns:viewModels="clr-namespace:TrackZ.Mobile.Features.Exercises;assembly=TrackZ.Mobile.Core"
    x:DataType="viewModels:ExercisePickerViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    Shell.NavBarHasShadow="False"
    Title="{Binding Text.ChooseExercises}">
    <Grid Padding="16,8,16,0" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <SearchBar
            CancelButtonColor="{DynamicResource TrackZPrimary}"
            MinimumHeightRequest="44"
            Placeholder="{Binding Text.SearchExercises}"
            Text="{Binding SearchText, Mode=TwoWay}" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Clicked="OnClearBodyPartClicked" MinimumHeightRequest="44" Padding="14,8" Text="{Binding Text.All}" />
            <CollectionView
                Grid.Column="1"
                HeightRequest="44"
                HorizontalScrollBarVisibility="Never"
                ItemsSource="{Binding BodyPartOptions}"
                SelectedItem="{Binding SelectedBodyPartOption, Mode=TwoWay}"
                SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:BodyPartFilterOption">
                        <Border Padding="14,8" Stroke="{DynamicResource TrackZHairline}" StrokeShape="RoundRectangle 999">
                            <Label Style="{DynamicResource TrackZBodyStyle}" Text="{Binding Label}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SelectedCountText}" VerticalOptions="Center" />
            <Label Grid.Column="1" IsVisible="{Binding ShowOfflineBanner}" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.Offline}" VerticalOptions="Center" />
            <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsRefreshing}" IsVisible="{Binding IsRefreshing}" />
        </Grid>

        <Grid Grid.Row="3">
            <CollectionView IsVisible="{Binding HasResults}" ItemsSource="{Binding Exercises}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExercisePickerItem">
                        <components:ExercisePerformanceCard
                            Margin="0,0,0,10"
                            EditCommand="{Binding Source={x:Reference Page}, Path=EditCustomCommand}"
                            Exercise="{Binding .}"
                            ToggleCommand="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleSelectionCommand}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <components:ExerciseListSkeleton IsVisible="{Binding ShowLoading}" />
            <components:TrackZStateView
                ActionCommand="{Binding SignInCommand}"
                ActionText="{Binding Text.SignIn}"
                IsVisible="{Binding ShowAuthenticationRequired}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <components:TrackZStateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{Binding Text.TryAgain}"
                IsVisible="{Binding ShowOfflineEmpty}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <components:TrackZStateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{Binding Text.TryAgain}"
                IsVisible="{Binding ShowRequestFailure}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <components:TrackZStateView
                IsVisible="{Binding ShowNoMatches}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
        </Grid>

        <Border Grid.Row="4" Margin="-16,0,-16,0" Padding="16,12" BackgroundColor="{DynamicResource TrackZSurface}" StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Clicked="OnCreateCustomClicked" MinimumHeightRequest="48" Text="{Binding Text.CreateCustom}" />
                <Label Grid.Column="1" HorizontalTextAlignment="Center" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SelectedCountText}" VerticalOptions="Center" />
                <Button Grid.Column="2" Clicked="OnDoneClicked" MinimumHeightRequest="48" Style="{DynamicResource TrackZPrimaryButtonStyle}" Text="{Binding Text.Done}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
