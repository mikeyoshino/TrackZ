<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Exercises.ExercisePickerPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:models="clr-namespace:TrackZ.Mobile.Features.Exercises.Models;assembly=TrackZ.Mobile.Core"
    xmlns:viewModels="clr-namespace:TrackZ.Mobile.Features.Exercises;assembly=TrackZ.Mobile.Core"
    x:DataType="viewModels:ExercisePickerViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarHasShadow="False"
    Title="{Binding Text.ChooseExercises}">
    <Grid Padding="0,12,0,0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource TrackZSpace12}">
        <Grid Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <SearchBar
                x:Name="ExerciseSearch"
                HeightRequest="{DynamicResource TrackZFieldHeight}"
                Placeholder="{Binding Text.SearchExercises}"
                Style="{DynamicResource TrackZSearchBarStyle}"
                Text="{Binding SearchText, Mode=TwoWay}"
                VerticalOptions="Center" />
            <ActivityIndicator
                HorizontalOptions="End"
                IsRunning="{Binding IsRefreshing}"
                IsVisible="{Binding IsRefreshing}"
                Margin="0,0,12,0"
                VerticalOptions="Center" />
        </Grid>

        <Grid x:Name="BodyPartFilterBand" Grid.Row="1" Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <CollectionView
                x:Name="BodyPartFilters"
                HeightRequest="{DynamicResource TrackZMinimumTarget}"
                HorizontalScrollBarVisibility="Never"
                ItemsSource="{Binding BodyPartOptions}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:BodyPartFilterOption">
                        <Border Style="{DynamicResource TrackZSelectionChipStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectCommand}" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.StateTriggers>
                                            <StateTrigger IsActive="{Binding IsSelected}" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource TrackZPrimary}" />
                                            <Setter Property="Stroke" Value="{DynamicResource TrackZPrimary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label
                                Style="{DynamicResource TrackZBodyStyle}"
                                Text="{Binding Label}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TrackZPrimaryContrast}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid x:Name="ExerciseResults" Grid.Row="2" Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <CollectionView IsVisible="{Binding HasResults}" ItemsSource="{Binding Exercises}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExercisePickerItem">
                        <components:ExercisePerformanceCard
                            Margin="0,0,0,12"
                            EditCommand="{Binding Source={x:Reference Page}, Path=EditCustomCommand}"
                            Exercise="{Binding .}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <components:ExerciseListSkeleton IsVisible="{Binding ShowLoading}" />
            <components:TrackZStateView
                ActionCommand="{Binding SignInCommand}"
                ActionText="{Binding Text.SignIn}"
                IsVisible="{Binding ShowAuthenticationRequired}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <components:TrackZStateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{Binding Text.TryAgain}"
                IsVisible="{Binding ShowOfflineEmpty}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <components:TrackZStateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{Binding Text.TryAgain}"
                IsVisible="{Binding ShowRequestFailure}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <components:TrackZStateView
                IsVisible="{Binding ShowNoMatches}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
        </Grid>

        <Border
            x:Name="ExercisePickerActions"
            Grid.Row="3"
            Margin="0,0,0,12"
            Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}">
                <Button Clicked="OnCreateCustomClicked" Style="{DynamicResource TrackZQuietButtonStyle}" Text="{Binding Text.CreateCustom}" />
                <Label Grid.Column="1" HorizontalTextAlignment="Center" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SelectedCountText}" VerticalOptions="Center" />
                <Button
                    x:Name="DoneButton"
                    Grid.Column="2"
                    Command="{Binding Source={x:Reference Page}, Path=DoneCommand}"
                    Style="{DynamicResource TrackZPrimaryButtonStyle}"
                    Text="{Binding Text.Done}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
