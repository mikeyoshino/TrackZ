<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Exercises.ExercisePickerPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:models="clr-namespace:TrackZ.Mobile.Features.Exercises.Models;assembly=TrackZ.Mobile.Core"
    xmlns:viewModels="clr-namespace:TrackZ.Mobile.Features.Exercises;assembly=TrackZ.Mobile.Core"
    x:DataType="viewModels:ExercisePickerViewModel"
    Title="{Binding Text.ChooseExercises}">
    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <SearchBar
            Placeholder="{Binding Text.SearchExercises}"
            Text="{Binding SearchText, Mode=TwoWay}" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Picker
                Title="{Binding Text.AllBodyParts}"
                ItemDisplayBinding="{Binding Label}"
                ItemsSource="{Binding BodyPartOptions}"
                SelectedItem="{Binding SelectedBodyPartOption, Mode=TwoWay}" />
            <Button Grid.Column="1" Clicked="OnClearBodyPartClicked" Text="{Binding Text.All}" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Label
                FontAttributes="Bold"
                Text="{Binding SelectedCountText}"
                VerticalOptions="Center" />
            <ActivityIndicator
                Grid.Column="1"
                IsRunning="{Binding IsRefreshing}"
                IsVisible="{Binding IsRefreshing}" />
        </Grid>
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Exercises}"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label
                    HorizontalTextAlignment="Center"
                    Text="{Binding Source={x:Reference Page}, Path=BindingContext.Text.NoMatchingExercises}"
                    VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ExercisePickerItem">
                    <components:ExercisePerformanceCard
                        Margin="0,0,0,10"
                        EditCommand="{Binding Source={x:Reference Page}, Path=EditCustomCommand}"
                        Exercise="{Binding .}"
                        ToggleCommand="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleSelectionCommand}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Clicked="OnCreateCustomClicked" Text="{Binding Text.CreateCustom}" />
            <Button Grid.Column="1" Clicked="OnDoneClicked" Text="{Binding Text.Done}" />
        </Grid>
    </Grid>
</ContentPage>
