<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Exercises.ExercisePickerPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:models="clr-namespace:TrackZ.Mobile.Features.Exercises.Models;assembly=TrackZ.Mobile.Core"
    xmlns:viewModels="clr-namespace:TrackZ.Mobile.Features.Exercises;assembly=TrackZ.Mobile.Core"
    x:DataType="viewModels:ExercisePickerViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarHasShadow="False"
    Shell.TabBarIsVisible="False"
    Title="{Binding Text.ChooseExercises}">
    <Grid Padding="0,12,0,0" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="{DynamicResource TrackZSpace12}">
        <Grid Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <SearchBar
                x:Name="ExerciseSearch"
                HeightRequest="{DynamicResource TrackZFieldHeight}"
                Placeholder="{Binding Text.SearchExercises}"
                Style="{DynamicResource TrackZSearchBarStyle}"
                Text="{Binding SearchText, Mode=TwoWay}"
                VerticalOptions="Center" />
            <ActivityIndicator
                HorizontalOptions="End"
                IsRunning="{Binding IsRefreshing}"
                IsVisible="{Binding IsRefreshing}"
                Margin="0,0,12,0"
                VerticalOptions="Center" />
        </Grid>

        <Grid x:Name="BodyPartFilterBand" Grid.Row="1" Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <Border
                HorizontalOptions="Start"
                MinimumHeightRequest="{DynamicResource TrackZFieldHeight}"
                MinimumWidthRequest="{DynamicResource TrackZFilterTriggerWidth}"
                Style="{DynamicResource TrackZSelectionChipStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource TrackZSpace8}">
                    <Image
                        HeightRequest="{DynamicResource TrackZFilterIconSize}"
                        InputTransparent="True"
                        Source="filter.png"
                        VerticalOptions="Center"
                        WidthRequest="{DynamicResource TrackZFilterIconSize}" />
                    <Label
                        x:Name="BodyPartFilterLabel"
                        Grid.Column="1"
                        InputTransparent="True"
                        Style="{DynamicResource TrackZBodyStyle}"
                        Text="{Binding SelectedBodyPartFilterText}"
                        VerticalOptions="Center" />
                    <Image
                        Grid.Column="2"
                        HeightRequest="{DynamicResource TrackZChevronIconSize}"
                        InputTransparent="True"
                        Source="chevron_down.png"
                        VerticalOptions="Center"
                        WidthRequest="{DynamicResource TrackZChevronIconSize}" />
                    <Picker
                        x:Name="BodyPartFilterPicker"
                        Grid.ColumnSpan="3"
                        ItemDisplayBinding="{Binding Label}"
                        ItemsSource="{Binding BodyPartOptions}"
                        MinimumHeightRequest="{DynamicResource TrackZMinimumTarget}"
                        MinimumWidthRequest="{DynamicResource TrackZFilterTriggerWidth}"
                        BackgroundColor="Transparent"
                        SelectedItem="{Binding SelectedBodyPartOption, Mode=TwoWay}"
                        SemanticProperties.Description="{Binding SelectedBodyPartFilterText}"
                        Style="{DynamicResource TrackZPickerStyle}"
                        TextColor="Transparent"
                        TitleColor="Transparent" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ExerciseResults" Grid.Row="2" Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <CollectionView IsVisible="{Binding HasResults}" ItemsSource="{Binding Exercises}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExercisePickerItem">
                        <components:ExercisePerformanceCard
                            Margin="0,0,0,12"
                            EditCommand="{Binding Source={x:Reference Page}, Path=EditCustomCommand}"
                            Exercise="{Binding .}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <components:ExerciseListSkeleton IsVisible="{Binding ShowLoading}" />
            <components:TrackZStateView
                ActionCommand="{Binding SignInCommand}"
                ActionText="{Binding Text.SignIn}"
                IsVisible="{Binding ShowAuthenticationRequired}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <components:TrackZStateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{Binding Text.TryAgain}"
                IsVisible="{Binding ShowOfflineEmpty}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <components:TrackZStateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{Binding Text.TryAgain}"
                IsVisible="{Binding ShowRequestFailure}"
                Message="{Binding StateMessage}"
                Title="{Binding StateTitle}" />
            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding ShowNoMatches}"
                MaximumWidthRequest="360"
                Spacing="{DynamicResource TrackZSpace12}"
                VerticalOptions="Center">
                <Image
                    HeightRequest="{DynamicResource TrackZEmptyStateIconSize}"
                    Opacity="0.58"
                    Source="tab_train.png"
                    WidthRequest="{DynamicResource TrackZEmptyStateIconSize}" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{DynamicResource TrackZSectionTitleStyle}"
                    Text="{Binding StateTitle}" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{DynamicResource TrackZSecondaryStyle}"
                    Text="{Binding StateMessage}" />
            </VerticalStackLayout>
        </Grid>

        <Button
            x:Name="CreateCustomExerciseButton"
            Grid.Row="3"
            Clicked="OnCreateCustomClicked"
            ImageSource="plus.png"
            Margin="{DynamicResource TrackZPageHorizontalPadding}"
            BackgroundColor="Transparent"
            BorderColor="{DynamicResource TrackZPrimary}"
            BorderWidth="1"
            SemanticProperties.Description="{Binding Text.CreateCustom}"
            Style="{DynamicResource TrackZSecondaryButtonStyle}"
            TextColor="{DynamicResource TrackZPrimary}"
            Text="{Binding Text.CreateCustom}" />

        <Border
            x:Name="ExercisePickerActions"
            Grid.Row="4"
            Margin="0,0,0,12"
            Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}">
                <Label Style="{DynamicResource TrackZBodyStyle}" Text="{Binding SelectedCountText}" VerticalOptions="Center" />
                <Button
                    x:Name="DoneButton"
                    Grid.Column="1"
                    Command="{Binding Source={x:Reference Page}, Path=DoneCommand}"
                    IsEnabled="{Binding CanCompleteSelection}"
                    Style="{DynamicResource TrackZPrimaryButtonStyle}"
                    Text="{Binding Text.Done}">
                    <Button.Triggers>
                        <DataTrigger Binding="{Binding CanCompleteSelection}" TargetType="Button" Value="False">
                            <Setter Property="BackgroundColor" Value="{DynamicResource TrackZSurfaceRaised}" />
                            <Setter Property="TextColor" Value="{DynamicResource TrackZTextSecondary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
