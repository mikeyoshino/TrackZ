<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Exercises.CustomExercisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:TrackZ.Mobile.Features.Exercises;assembly=TrackZ.Mobile.Core"
    x:DataType="viewModels:CustomExerciseViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Title="{Binding Text.CustomExerciseTitle}">
    <Grid Padding="0,12,0,0" RowDefinitions="*,Auto" RowSpacing="{DynamicResource TrackZSpace12}">
        <ScrollView>
            <VerticalStackLayout
                x:Name="CustomExerciseForm"
                Padding="{DynamicResource TrackZPageHorizontalPadding}"
                Spacing="{DynamicResource TrackZSpace12}">
                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                    <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.CustomExerciseFormTitle}" />
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.CustomExerciseIntro}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.ExerciseName}" />
                    <Border x:Name="CustomExerciseNameField" Style="{DynamicResource TrackZFieldContainerStyle}">
                        <Entry Placeholder="{Binding Text.ExerciseName}" Style="{DynamicResource TrackZFieldStyle}" Text="{Binding Name, Mode=TwoWay}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.BodyPart}" />
                    <Border x:Name="CustomExerciseBodyPartField" Style="{DynamicResource TrackZFieldContainerStyle}">
                        <Picker
                            BackgroundColor="Transparent"
                            ItemDisplayBinding="{Binding Label}"
                            ItemsSource="{Binding BodyPartOptions}"
                            SelectedItem="{Binding SelectedBodyPart, Mode=TwoWay}"
                            Style="{DynamicResource TrackZPickerStyle}"
                            Title="{Binding Text.BodyPart}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.TrackingModeQuestion}" />
                    <Border x:Name="CustomExerciseTrackingField" Style="{DynamicResource TrackZFieldContainerStyle}">
                        <Picker
                            BackgroundColor="Transparent"
                            ItemDisplayBinding="{Binding Label}"
                            ItemsSource="{Binding TrackingModeOptions}"
                            SelectedItem="{Binding SelectedTrackingMode, Mode=TwoWay}"
                            Style="{DynamicResource TrackZPickerStyle}"
                            Title="{Binding Text.TrackingMode}" />
                    </Border>
                </VerticalStackLayout>

                <Border Style="{DynamicResource TrackZCardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}">
                        <Border
                            HeightRequest="{DynamicResource TrackZMinimumTarget}"
                            Style="{DynamicResource TrackZArtworkFrameStyle}"
                            WidthRequest="{DynamicResource TrackZMinimumTarget}">
                            <Grid>
                                <Label
                                    HorizontalTextAlignment="Center"
                                    Style="{DynamicResource TrackZSecondaryStyle}"
                                    Text="{Binding Text.ExerciseImagePlaceholder}"
                                    VerticalTextAlignment="Center" />
                                <Image
                                    x:Name="CustomExerciseImagePreview"
                                    Aspect="AspectFill"
                                    HeightRequest="{DynamicResource TrackZMinimumTarget}"
                                    Source="{Binding PreviewImagePath}"
                                    WidthRequest="{DynamicResource TrackZMinimumTarget}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="{DynamicResource TrackZSpace4}" VerticalOptions="Center">
                            <Label Style="{DynamicResource TrackZBodyStyle}" Text="{Binding Text.OptionalExerciseImage}" />
                            <Label LineBreakMode="WordWrap" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.ExerciseImageOptionalHelp}" />
                        </VerticalStackLayout>
                        <Button
                            x:Name="AddCustomExerciseImage"
                            Grid.Column="2"
                            Clicked="OnChooseImageClicked"
                            SemanticProperties.Description="{Binding Text.AddExerciseImage}"
                            Style="{DynamicResource TrackZQuietButtonStyle}"
                            Text="{Binding Text.AddExerciseImage}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Margin="0,0,0,12" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Button Clicked="OnSaveClicked" SemanticProperties.Description="{Binding Text.SaveExercise}" Style="{DynamicResource TrackZPrimaryButtonStyle}" Text="{Binding Text.SaveExercise}" />
        </Border>
    </Grid>
</ContentPage>
