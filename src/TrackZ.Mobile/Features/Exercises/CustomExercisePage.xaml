<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Exercises.CustomExercisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:TrackZ.Mobile.Features.Exercises.Data;assembly=TrackZ.Mobile.Core"
    xmlns:viewModels="clr-namespace:TrackZ.Mobile.Features.Exercises;assembly=TrackZ.Mobile.Core"
    x:DataType="viewModels:CustomExerciseViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Title="Custom exercise">
    <Grid Padding="0,16,0,0" RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource TrackZSpace16}">
        <Grid Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <Label Style="{DynamicResource TrackZNavigationTitleStyle}" Text="Custom exercise" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{DynamicResource TrackZPageHorizontalPadding}" Spacing="{DynamicResource TrackZSpace16}">
                <Entry Placeholder="Exercise name" Style="{DynamicResource TrackZFieldStyle}" Text="{Binding Name, Mode=TwoWay}" />
                <Picker Title="Body part" ItemsSource="{Binding BodyParts}" SelectedItem="{Binding BodyPart, Mode=TwoWay}" />
                <Picker Title="Tracking mode" ItemsSource="{Binding TrackingModes}" SelectedItem="{Binding TrackingMode, Mode=TwoWay}" />
                <Image Aspect="AspectFit" HeightRequest="220" Source="{Binding PreviewImagePath}" />
                <Button Clicked="OnChooseImageClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="Choose JPEG, PNG, or WebP" />
                <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="Published library images" />
                <CollectionView
                    HeightRequest="128"
                    ItemsSource="{Binding LibraryImages}"
                    SelectedItem="{Binding SelectedLibraryImage, Mode=TwoWay}"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:CachedLibraryImage">
                            <VerticalStackLayout WidthRequest="104" Spacing="{DynamicResource TrackZSpace4}">
                                <Image Aspect="AspectFill" HeightRequest="88" Source="{Binding ThumbnailUri}" />
                                <Label LineBreakMode="TailTruncation" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Name}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label
                    Style="{DynamicResource TrackZSecondaryStyle}"
                    Text="The original file is retained for secure upload; only this preview is resized. Published library images can also be assigned when available." />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Button Clicked="OnSaveClicked" Style="{DynamicResource TrackZPrimaryButtonStyle}" Text="Save exercise" />
        </Border>
    </Grid>
</ContentPage>
