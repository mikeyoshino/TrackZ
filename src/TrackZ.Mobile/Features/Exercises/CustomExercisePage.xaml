<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Exercises.CustomExercisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:TrackZ.Mobile.Features.Exercises.Data;assembly=TrackZ.Mobile.Core"
    xmlns:viewModels="clr-namespace:TrackZ.Mobile.Features.Exercises;assembly=TrackZ.Mobile.Core"
    x:DataType="viewModels:CustomExerciseViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Title="{Binding Text.CustomExerciseTitle}">
    <Grid Padding="0,12,0,0" RowDefinitions="*,Auto" RowSpacing="{DynamicResource TrackZSpace12}">
        <ScrollView>
            <VerticalStackLayout Padding="{DynamicResource TrackZPageHorizontalPadding}" Spacing="{DynamicResource TrackZSpace16}">
                <Entry Placeholder="{Binding Text.ExerciseName}" Style="{DynamicResource TrackZFieldStyle}" Text="{Binding Name, Mode=TwoWay}" />
                <Picker ItemDisplayBinding="{Binding Label}" Style="{DynamicResource TrackZPickerStyle}" Title="{Binding Text.BodyPart}" ItemsSource="{Binding BodyPartOptions}" SelectedItem="{Binding SelectedBodyPart, Mode=TwoWay}" />
                <Picker ItemDisplayBinding="{Binding Label}" Style="{DynamicResource TrackZPickerStyle}" Title="{Binding Text.TrackingMode}" ItemsSource="{Binding TrackingModeOptions}" SelectedItem="{Binding SelectedTrackingMode, Mode=TwoWay}" />
                <Image Aspect="AspectFit" HeightRequest="{DynamicResource TrackZExerciseCardHeight}" Source="{Binding PreviewImagePath}" />
                <Button Clicked="OnChooseImageClicked" SemanticProperties.Description="{Binding Text.ChooseExerciseImage}" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.ChooseExerciseImage}" />
                <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.PublishedLibraryImages}" />
                <CollectionView
                    HeightRequest="{DynamicResource TrackZExerciseCardHeight}"
                    ItemsSource="{Binding LibraryImages}"
                    SelectedItem="{Binding SelectedLibraryImage, Mode=TwoWay}"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="{DynamicResource TrackZSpace8}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:CachedLibraryImage">
                            <VerticalStackLayout WidthRequest="{DynamicResource TrackZExerciseCardHeight}" Spacing="{DynamicResource TrackZSpace4}">
                                <Image Aspect="AspectFill" HeightRequest="{DynamicResource TrackZExerciseArtworkSize}" Source="{Binding ThumbnailUri}" />
                                <Label LineBreakMode="TailTruncation" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Name}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label
                    Style="{DynamicResource TrackZSecondaryStyle}"
                    Text="{Binding Text.ExerciseImageRetentionHelp}" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Margin="0,0,0,12" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Button Clicked="OnSaveClicked" SemanticProperties.Description="{Binding Text.SaveExercise}" Style="{DynamicResource TrackZPrimaryButtonStyle}" Text="{Binding Text.SaveExercise}" />
        </Border>
    </Grid>
</ContentPage>
