<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Exercises.CustomExercisePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:TrackZ.Mobile.Components"
    xmlns:viewModels="clr-namespace:TrackZ.Mobile.Features.Exercises;assembly=TrackZ.Mobile.Core"
    x:DataType="viewModels:CustomExerciseViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="Container"
    Shell.TabBarIsVisible="False"
    Title="{Binding Text.CustomExerciseTitle}">
    <Grid Padding="0,12,0,0" RowDefinitions="*,Auto" RowSpacing="{DynamicResource TrackZSpace12}">
        <ScrollView>
            <VerticalStackLayout
                x:Name="CustomExerciseForm"
                Padding="{DynamicResource TrackZPageHorizontalPadding}"
                Spacing="{DynamicResource TrackZSpace12}">
                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                    <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.CustomExerciseFormTitle}" />
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.CustomExerciseIntro}" />
                </VerticalStackLayout>

                <Border
                    x:Name="CustomExercisePhotoCard"
                    Style="{DynamicResource TrackZEquipmentPhotoStyle}">
                    <Grid>
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="{DynamicResource TrackZSpace8}"
                            VerticalOptions="Center">
                            <Image
                                HeightRequest="32"
                                Opacity="0.62"
                                Source="camera.png"
                                WidthRequest="32" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{DynamicResource TrackZSecondaryStyle}"
                                Text="{Binding Text.ExerciseImagePlaceholder}" />
                        </VerticalStackLayout>
                        <Image
                            x:Name="CustomExerciseImagePreview"
                            Aspect="AspectFill"
                            Source="{Binding PreviewImagePath}" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource TrackZSpace8}">
                    <Button
                        x:Name="CaptureCustomExerciseImage"
                        Clicked="OnCaptureImageClicked"
                        ImageSource="camera_dark.png"
                        BackgroundColor="{DynamicResource TrackZPrimary}"
                        SemanticProperties.Description="{Binding Text.CaptureExerciseImage}"
                        Style="{DynamicResource TrackZSecondaryButtonStyle}"
                        TextColor="{DynamicResource TrackZPrimaryContrast}"
                        Text="{Binding Text.CaptureExerciseImage}" />
                    <Button
                        x:Name="AddCustomExerciseImage"
                        Grid.Column="1"
                        Clicked="OnChooseImageClicked"
                        ImageSource="gallery.png"
                        BackgroundColor="Transparent"
                        BorderColor="{DynamicResource TrackZPrimary}"
                        BorderWidth="1"
                        SemanticProperties.Description="{Binding Text.ChooseExerciseImage}"
                        Style="{DynamicResource TrackZSecondaryButtonStyle}"
                        TextColor="{DynamicResource TrackZPrimary}"
                        Text="{Binding Text.ChooseExerciseImage}" />
                </Grid>

                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.ExerciseName}" />
                    <Border x:Name="CustomExerciseNameField" Style="{DynamicResource TrackZFieldContainerStyle}">
                        <Entry
                            x:Name="CustomExerciseNameInput"
                            Focused="OnFormInputFocused"
                            HandlerChanged="OnNameInputHandlerChanged"
                            Placeholder="{Binding Text.ExerciseName}"
                            Style="{DynamicResource TrackZFieldStyle}"
                            Text="{Binding Name, Mode=TwoWay}"
                            Unfocused="OnFormInputUnfocused" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.BodyPart}" />
                    <Border x:Name="CustomExerciseBodyPartField" Style="{DynamicResource TrackZFieldContainerStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{DynamicResource TrackZBodyStyle}" Text="{Binding BodyPartSelectionText}" VerticalOptions="Center" />
                            <Image Grid.Column="1" HeightRequest="16" Source="chevron_down.png" VerticalOptions="Center" WidthRequest="16" />
                            <Button
                                x:Name="CustomExerciseBodyPartButton"
                                Grid.ColumnSpan="2"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Clicked="OnBodyPartClicked"
                                SemanticProperties.Description="{Binding Text.BodyPart}"
                                Style="{DynamicResource TrackZQuietButtonStyle}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.TrackingModeQuestion}" />
                    <Border x:Name="CustomExerciseTrackingField" Style="{DynamicResource TrackZFieldContainerStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{DynamicResource TrackZBodyStyle}" Text="{Binding TrackingModeSelectionText}" VerticalOptions="Center" />
                            <Image Grid.Column="1" HeightRequest="16" Source="chevron_down.png" VerticalOptions="Center" WidthRequest="16" />
                            <Button
                                x:Name="CustomExerciseTrackingButton"
                                Grid.ColumnSpan="2"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Clicked="OnTrackingModeClicked"
                                SemanticProperties.Description="{Binding Text.TrackingMode}"
                                Style="{DynamicResource TrackZQuietButtonStyle}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Border
            x:Name="CustomExerciseActions"
            Grid.Row="1"
            Margin="0,0,0,12"
            Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Button Clicked="OnSaveClicked" SemanticProperties.Description="{Binding Text.SaveExercise}" Style="{DynamicResource TrackZPrimaryButtonStyle}" Text="{Binding Text.SaveExercise}" />
        </Border>
        <components:BusyOverlay x:Name="SavingOverlay" Grid.RowSpan="2" />
    </Grid>
</ContentPage>
