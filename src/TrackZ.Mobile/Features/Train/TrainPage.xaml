<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Train.TrainPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:train="clr-namespace:TrackZ.Mobile.Features.Train;assembly=TrackZ.Mobile.Core"
    x:DataType="train:TrainTodayViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False"
    Title="{Binding Text.TrainTodayTitle}">
    <ScrollView
        x:Name="MomentumHomeScroll"
        Padding="{DynamicResource TrackZPageContentPadding}">
        <VerticalStackLayout Spacing="{DynamicResource TrackZSpace16}">
            <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                <Label x:Name="HomeContextLabel" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding HomeContextText}" />
                <Label Style="{DynamicResource TrackZPageTitleStyle}" Text="{Binding HomeHeadlineText}" />
            </VerticalStackLayout>

            <Border
                x:Name="HomeHero"
                SemanticProperties.Description="{Binding HeroSupportingText}"
                Style="{DynamicResource TrackZHomeHeroStyle}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WorkoutState">
                        <VisualState x:Name="Ready">
                            <VisualState.StateTriggers>
                                <StateTrigger IsActive="{Binding ShowStartHero}" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource TrackZPrimary}" />
                                <Setter Property="Stroke" Value="{DynamicResource TrackZPrimary}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Active">
                            <VisualState.StateTriggers>
                                <StateTrigger IsActive="{Binding ShowContinueHero}" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{DynamicResource TrackZSurface}" />
                                <Setter Property="Stroke" Value="{DynamicResource TrackZHairline}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace12}">
                    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace4}">
                        <Label x:Name="HeroEyebrowLabel" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding HeroEyebrowText}">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding ShowStartHero}" TargetType="Label" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource TrackZPrimaryContrast}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label x:Name="HeroTitleLabel" Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding HeroTitleText}">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding ShowStartHero}" TargetType="Label" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource TrackZPrimaryContrast}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label x:Name="HeroSupportingLabel" Style="{DynamicResource TrackZBodyStyle}" Text="{Binding HeroSupportingText}">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding ShowStartHero}" TargetType="Label" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource TrackZPrimaryContrast}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <ProgressBar
                            IsVisible="{Binding ShowContinueHero}"
                            Progress="{Binding ActiveWorkoutProgress}"
                            ProgressColor="{DynamicResource TrackZPrimary}"
                            SemanticProperties.Description="{Binding HeroSupportingText}" />
                    </VerticalStackLayout>
                    <Button
                        x:Name="HeroActionButton"
                        Command="{Binding HeroActionCommand}"
                        IsEnabled="{Binding CanMutate}"
                        SemanticProperties.Description="{Binding HeroActionText}"
                        Style="{DynamicResource TrackZPrimaryButtonStyle}"
                        Text="{Binding HeroActionText}">
                        <Button.Triggers>
                            <DataTrigger Binding="{Binding ShowStartHero}" TargetType="Button" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource TrackZPrimaryContrast}" />
                                <Setter Property="TextColor" Value="{DynamicResource TrackZPrimary}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout
                x:Name="TrainAgainSection"
                IsVisible="{Binding ShowTrainAgain}"
                Spacing="{DynamicResource TrackZSpace8}">
                <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.TrainAgain}" />
                <Border
                    x:Name="TrainAgainCard"
                    IsVisible="{Binding ShowTrainAgain}"
                    MinimumHeightRequest="{DynamicResource TrackZExerciseCardHeight}"
                    SemanticProperties.Description="{Binding RepeatWorkoutAccessibilityText}"
                    Style="{DynamicResource TrackZListRowStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TrainAgainCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnSpacing="{DynamicResource TrackZSpace12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{DynamicResource TrackZExerciseArtworkColumnWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="TrainAgainArtwork"
                            AutomationProperties.ExcludedWithChildren="True"
                            HeightRequest="{DynamicResource TrackZExerciseArtworkSize}"
                            Style="{DynamicResource TrackZArtworkFrameStyle}"
                            WidthRequest="{DynamicResource TrackZExerciseArtworkSize}">
                            <Grid>
                                <Image x:Name="TrainAgainFallback" Aspect="AspectFit" Source="exercise_placeholder.png" />
                                <Image x:Name="TrainAgainThumbnail" Aspect="AspectFill" Source="{Binding RepeatWorkout.ThumbnailPath}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="{DynamicResource TrackZSpace4}" VerticalOptions="Center">
                            <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding RepeatWorkoutTitle}" />
                            <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding RepeatWorkoutMetaText}" />
                        </VerticalStackLayout>
                        <Label
                            Grid.Column="2"
                            Style="{DynamicResource TrackZBodyStyle}"
                            Text="{Binding Text.Open}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Border
                x:Name="WeeklyGoalCard"
                IsVisible="{Binding HasAuthoritativeProgress}"
                Style="{DynamicResource TrackZCardStyle}">
                <VerticalStackLayout Spacing="{DynamicResource TrackZSpace8}">
                    <Label
                        x:Name="WeeklyGoalSentence"
                        Style="{DynamicResource TrackZSectionTitleStyle}"
                        Text="{Binding WeeklyGoalSentenceText}" />
                    <Label
                        x:Name="WeeklyStreakSentence"
                        IsVisible="{Binding HasWeeklyStreak}"
                        Style="{DynamicResource TrackZSecondaryStyle}"
                        Text="{Binding WeeklyStreakSentenceText}" />
                    <ProgressBar Progress="{Binding WeeklyProgress}" ProgressColor="{DynamicResource TrackZPrimary}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout
                x:Name="LatestPerformanceSection"
                IsVisible="{Binding HasRecentMomentum}"
                Spacing="{DynamicResource TrackZSpace8}">
                <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.HomeLatestPerformance}" />
                <Border
                    x:Name="LatestPerformanceCard"
                    IsVisible="{Binding HasRecentMomentum}"
                    MinimumHeightRequest="{DynamicResource TrackZExerciseCardHeight}"
                    Style="{DynamicResource TrackZListRowStyle}">
                    <VerticalStackLayout Spacing="{DynamicResource TrackZSpace8}">
                        <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding LatestPerformanceTitle}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource TrackZSpace4}">
                            <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Text.HomeLatestLabel}" />
                            <Label
                                x:Name="LatestPerformanceValue"
                                Grid.Column="1"
                                HorizontalTextAlignment="End"
                                Style="{DynamicResource TrackZBodyStyle}"
                                Text="{Binding LatestPerformanceValue}" />
                            <Label
                                Grid.Row="1"
                                Style="{DynamicResource TrackZSecondaryStyle}"
                                Text="{Binding Text.HomeBestLabel}" />
                            <Label
                                x:Name="BestPerformanceValue"
                                Grid.Column="1"
                                Grid.Row="1"
                                HorizontalTextAlignment="End"
                                Style="{DynamicResource TrackZBodyStyle}"
                                Text="{Binding BestPerformanceValue}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout
                x:Name="HomeErrorState"
                IsVisible="{Binding HasError}"
                Spacing="{DynamicResource TrackZSpace8}">
                <Label Style="{DynamicResource TrackZInlineErrorStyle}" Text="{Binding ErrorText}" />
                <Button
                    x:Name="HomeRetryButton"
                    Command="{Binding RetryCommand}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding HasLoadRetry}"
                    SemanticProperties.Description="{Binding Text.TryAgain}"
                    Style="{DynamicResource TrackZSecondaryButtonStyle}"
                    Text="{Binding Text.TryAgain}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
