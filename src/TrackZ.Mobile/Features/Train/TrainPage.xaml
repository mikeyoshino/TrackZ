<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Train.TrainPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:train="clr-namespace:TrackZ.Mobile.Features.Train;assembly=TrackZ.Mobile.Core"
    x:DataType="train:TrainTodayViewModel"
    BackgroundColor="{DynamicResource TrackZBackground}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False"
    Title="{Binding Text.TrainTodayTitle}">
    <Grid Padding="0,16,0,0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource TrackZSpace16}">
        <Grid Padding="{DynamicResource TrackZPageHorizontalPadding}">
            <Label Style="{DynamicResource TrackZPageTitleStyle}" Text="{Binding Text.TrainTodayTitle}" />
        </Grid>

        <Grid Grid.Row="1" Padding="{DynamicResource TrackZPageHorizontalPadding}">
          <Border
            IsVisible="{Binding HasActiveWorkout}"
            Style="{DynamicResource TrackZListRowStyle}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.ResumeWorkout}" />
                <Label Grid.Row="1" Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding SavedSetCountText}" />
                <Button Grid.Column="1" Grid.RowSpan="2" Clicked="OnResumeClicked" Style="{DynamicResource TrackZQuietButtonStyle}" Text="›" />
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="{DynamicResource TrackZPageHorizontalPadding}" RowDefinitions="Auto,*" RowSpacing="{DynamicResource TrackZSpace12}">
            <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Text.Recent}" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding RecentWorkouts}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding Source={x:Reference Page}, Path=BindingContext.Text.NoRecentWorkouts}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="train:RecentWorkoutItem">
                        <Border Margin="0,0,0,12" Style="{DynamicResource TrackZListRowStyle}">
                            <Grid ColumnSpacing="{DynamicResource TrackZSpace12}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource TrackZExerciseArtworkColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border HeightRequest="{DynamicResource TrackZExerciseArtworkSize}" WidthRequest="{DynamicResource TrackZExerciseArtworkSize}" Style="{DynamicResource TrackZArtworkFrameStyle}">
                                    <Image Aspect="AspectFill" SemanticProperties.Description="{Binding Title}" Source="{Binding ThumbnailPath}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="{DynamicResource TrackZSpace4}">
                                    <Label Style="{DynamicResource TrackZSectionTitleStyle}" Text="{Binding Title}" />
                                    <Label Style="{DynamicResource TrackZSecondaryStyle}" Text="{Binding ExerciseCountText}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" VerticalOptions="Center" Text="›" TextColor="{DynamicResource TrackZTextSecondary}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Grid.Row="3" Style="{DynamicResource TrackZStickyActionContainerStyle}">
            <Button
                Clicked="OnChooseWorkoutClicked"
                Style="{DynamicResource TrackZPrimaryButtonStyle}"
                Text="{Binding Text.ChooseWorkout}" />
        </Border>
    </Grid>
</ContentPage>
