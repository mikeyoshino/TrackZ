<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TrackZ.Mobile.Features.Train.BodyAreaSheetPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource TrackZSurface}"
    SafeAreaEdges="All"
    Shell.NavBarIsVisible="False">
    <Grid Padding="0,16,0,20" RowDefinitions="Auto,*" RowSpacing="{DynamicResource TrackZSpace24}">
        <Grid Padding="{DynamicResource TrackZPageHorizontalPadding}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource TrackZSpace4}">
            <Label
                x:Name="BodyAreaTitle"
                Style="{DynamicResource TrackZNavigationTitleStyle}"
                Text="{Binding Text.ChooseWorkout}"
                VerticalOptions="Center" />
            <ImageButton
                x:Name="BodyAreaCloseButton"
                Grid.Column="1"
                Grid.RowSpan="2"
                Clicked="OnCloseClicked"
                SemanticProperties.Description="{Binding Text.Cancel}"
                Source="close.png"
                Style="{DynamicResource TrackZAuthBackButtonStyle}"
                VerticalOptions="Center" />
            <Label
                x:Name="BodyAreaSupporting"
                Grid.Row="1"
                Style="{DynamicResource TrackZSecondaryStyle}"
                Text="{Binding Text.AllBodyParts}" />
        </Grid>

        <Grid Grid.Row="1" Padding="{DynamicResource TrackZPageHorizontalPadding}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource TrackZSpace12}" RowSpacing="{DynamicResource TrackZSpace12}" VerticalOptions="Start">
            <Button Grid.Row="0" Grid.Column="0" MinimumHeightRequest="{DynamicResource TrackZBodyAreaChoiceHeight}" CommandParameter="Chest" Clicked="OnBodyAreaClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.BodyPartChest}" />
            <Button Grid.Row="0" Grid.Column="1" MinimumHeightRequest="{DynamicResource TrackZBodyAreaChoiceHeight}" CommandParameter="Back" Clicked="OnBodyAreaClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.BodyPartBack}" />
            <Button Grid.Row="1" Grid.Column="0" MinimumHeightRequest="{DynamicResource TrackZBodyAreaChoiceHeight}" CommandParameter="Shoulders" Clicked="OnBodyAreaClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.BodyPartShoulders}" />
            <Button Grid.Row="1" Grid.Column="1" MinimumHeightRequest="{DynamicResource TrackZBodyAreaChoiceHeight}" CommandParameter="Arms" Clicked="OnBodyAreaClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.BodyPartArms}" />
            <Button Grid.Row="2" Grid.Column="0" MinimumHeightRequest="{DynamicResource TrackZBodyAreaChoiceHeight}" CommandParameter="Legs" Clicked="OnBodyAreaClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.BodyPartLegs}" />
            <Button Grid.Row="2" Grid.Column="1" MinimumHeightRequest="{DynamicResource TrackZBodyAreaChoiceHeight}" CommandParameter="Core" Clicked="OnBodyAreaClicked" Style="{DynamicResource TrackZSecondaryButtonStyle}" Text="{Binding Text.BodyPartCore}" />
        </Grid>
    </Grid>
</ContentPage>
